arch=arm
baudrate=115200
board=lq560plusv100
board_name=lq560plusv100
bootdelay=2
cpu=armv8
ethact=gmac0
loadaddr=0x40080000
soc=lq560plusv100
stderr=serial
stdin=serial
stdout=serial
vendor=vendor
verify=n

bootargs=mem=132928K console=ttyAMA0,115200 clk_ignore_unused root=/dev/ram0 rootfstype=romfs initrd=0x44000000,0x2000000
bootcmd=ab_part_offset bl31 1 kernel 1 rootfs 1; sf probe 0;sf read 0x4000fe00 ${bl31_offset} 0x10000; ipcboot bl31 0x4000fe00; rugzip ${kernel_offset} 0x43000000 0x42000000 0x20000; rugzip ${rootfs_offset} 0x46000000 0x44000000 0x20000;ipcboot uimgfdt 0x42000000
