+- [ ] **Step 6: å®ç° `uvc_dump_init()` ä¸ `uvc_dump_deinit()`**
+
+```c
+int uvc_dump_init(void)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    const char *dump_dir = uvc_dump_get_str_env("UVC_DUMP_DIR", UVC_DUMP_DEFAULT_DIR);
+
+    ctx->dump_frames = uvc_dump_get_uint_env("UVC_DUMP_FRAMES", 0);
+    ctx->keep_runs    = uvc_dump_get_uint_env("UVC_DUMP_KEEP", 1);
+    ctx->dumped_count = 0;
+
+    if (ctx->dump_frames == 0) {
+        ctx->enabled = 0;
+        return 0;
+    }
+
+    if (strncpy_s(ctx->dump_dir, sizeof(ctx->dump_dir), dump_dir,
+                  sizeof(ctx->dump_dir) - 1) != 0) {
+        printf("[UVC_DUMP] dump dir too long\n");
+        ctx->enabled = 0;
+        return -1;
+    }
+
+    if (uvc_dump_ensure_dir(ctx->dump_dir) != 0) {
+        ctx->enabled = 0;
+        return -1;
+    }
+
+    uvc_dump_make_run_id(ctx->run_id, sizeof(ctx->run_id));
+    uvc_dump_cleanup_old_runs(ctx->dump_dir, ctx->keep_runs);
+    ctx->enabled = 1;
+
+    printf("###UVC_DUMP_START### dir=%s run=%s frames=%u\n",
+           ctx->dump_dir, ctx->run_id, ctx->dump_frames);
+    return 0;
+}
+
+void uvc_dump_deinit(void)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    if (ctx->enabled && ctx->dumped_count > 0) {
+        printf("[UVC_DUMP] total dumped %u frames to %s\n",
+               ctx->dumped_count, ctx->dump_dir);
+    }
+    ctx->enabled = 0;
+}
+```
