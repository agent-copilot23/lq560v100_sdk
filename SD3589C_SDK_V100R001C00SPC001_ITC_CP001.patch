+/* MIPI ç´§å‡‘ RAW10(4px/5B)â†’ u16 å®¹å™¨ã€‚åŸå§‹å®ç°ä¿ç•™ç”¨äºå¯¹æ¯”ã€‚ */
+static void sample_uvc_raw10_mipi_to_u16(const ot_u8 *src, ot_u32 src_stride,
+    ot_u16 *dst, ot_u32 width, ot_u32 height)
+{
+    for (ot_u32 row = 0; row < height; row++) {
+        const ot_u8 *s = src + (ot_u64)row * src_stride;
+        ot_u16 *d = dst + (ot_u64)row * width;
+        ot_u32 x = 0;
+        for (; x + 4 <= width; x += 4) {
+            ot_u8 b0 = s[0], b1 = s[1], b2 = s[2], b3 = s[3], b4 = s[4];
+            ot_u32 p0 = ((ot_u32)b0 << 2) | (b4 & 0x3);
+            ot_u32 p1 = ((ot_u32)b1 << 2) | ((b4 >> 2) & 0x3);
+            ot_u32 p2 = ((ot_u32)b2 << 2) | ((b4 >> 4) & 0x3);
+            ot_u32 p3 = ((ot_u32)b3 << 2) | ((b4 >> 6) & 0x3);
+#if RAW10_U16_MSB_JUSTIFIED
+            d[0] = (ot_u16)(p0 << 6); d[1] = (ot_u16)(p1 << 6);
+            d[2] = (ot_u16)(p2 << 6); d[3] = (ot_u16)(p3 << 6);
+#else
+            d[0] = (ot_u16)p0; d[1] = (ot_u16)p1;
+            d[2] = (ot_u16)p2; d[3] = (ot_u16)p3;
+#endif
+            s += 5;
+            d += 4;
+        }
+        for (; x < width; x++) {
+            ot_u32 grp = x / 4, pos = x % 4;
+            const ot_u8 *g = src + (ot_u64)row * src_stride + grp * 5;
+            ot_u32 hi = g[pos];
+            ot_u32 lo = (g[4] >> (pos * 2)) & 0x3;
+            ot_u32 p = (hi << 2) | lo;
+#if RAW10_U16_MSB_JUSTIFIED
+            dst[(ot_u64)row * width + x] = (ot_u16)(p << 6);
+#else
+            dst[(ot_u64)row * width + x] = (ot_u16)p;
+#endif
+        }
+    }
+}
+
+/* MIPI RAW10(4px/5B) -> u16ï¼Œç®—æ³•ä¸ vi_chn_dump.c çš„
+ * vi_raw_convert_bit_pixel() ä¿æŒä¸€è‡´ã€‚data_num æŒ‰åƒç´ æ•°ä¼ å…¥ï¼Œ
+ * æ¯ 4 åƒç´ ä» 5 å­—èŠ‚å°ç«¯ 40-bit å®¹å™¨ä¸­æå–ä¸€ä¸ª 10-bit åƒç´ ã€‚
+ */
+static void sample_uvc_raw10_mipi_to_u16_v2(const ot_u8 *src, ot_u32 src_stride,
+    ot_u16 *dst, ot_u32 width, ot_u32 height)
+{
+    for (ot_u32 row = 0; row < height; row++) {
+        const ot_u8 *row_src = src + (ot_u64)row * src_stride;
+        ot_u16 *row_dst = dst + (ot_u64)row * width;
+        ot_u32 group_num = width / 4; /* 4 pixels consist of 5 bytes */
+        ot_u32 tail_num = width % 4;
+
+        for (ot_u32 i = 0; i < group_num; i++) {
+            const ot_u8 *tmp_data = row_src + 5 * i;
+            ot_u64 u64_val = tmp_data[0] +
+                ((ot_u64)tmp_data[1] << 8) +
+                ((ot_u64)tmp_data[2] << 16) +
+                ((ot_u64)tmp_data[3] << 24) +
+                ((ot_u64)tmp_data[4] << 32);
+
+#if RAW10_U16_MSB_JUSTIFIED
+            row_dst[4 * i]     = (ot_u16)(((u64_val >> 0)  & 0x3ff) << 6);
+            row_dst[4 * i + 1] = (ot_u16)(((u64_val >> 10) & 0x3ff) << 6);
+            row_dst[4 * i + 2] = (ot_u16)(((u64_val >> 20) & 0x3ff) << 6);
+            row_dst[4 * i + 3] = (ot_u16)(((u64_val >> 30) & 0x3ff) << 6);
+#else
+            row_dst[4 * i]     = (ot_u16)((u64_val >> 0)  & 0x3ff);
+            row_dst[4 * i + 1] = (ot_u16)((u64_val >> 10) & 0x3ff);
+            row_dst[4 * i + 2] = (ot_u16)((u64_val >> 20) & 0x3ff);
+            row_dst[4 * i + 3] = (ot_u16)((u64_val >> 30) & 0x3ff);
+#endif
+        }
+
+        if (tail_num != 0) {
+            const ot_u8 *tmp_data = row_src + 5 * group_num;
+            ot_u64 u64_val = tmp_data[0] +
+                ((ot_u64)tmp_data[1] << 8) +
+                ((ot_u64)tmp_data[2] << 16) +
+                ((ot_u64)tmp_data[3] << 24) +
+                ((ot_u64)tmp_data[4] << 32);
+            ot_u32 tail_base = 4 * group_num;
+
+            for (ot_u32 j = 0; j < tail_num; j++) {
+#if RAW10_U16_MSB_JUSTIFIED
+                row_dst[tail_base + j] =
+                    (ot_u16)(((u64_val >> (10 * j)) & 0x3ff) << 6);
+#else
+                row_dst[tail_base + j] =
+                    (ot_u16)((u64_val >> (10 * j)) & 0x3ff);
+#endif
+            }
+        }
+    }
+}
