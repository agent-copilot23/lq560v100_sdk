-
+#include "math.h"
 
 #ifdef __cplusplus
 extern "C" {
@@ -231,6 +231,72 @@
     ot_scenecomm_check_return(ret, OT_SCENE_EINTER);
 
     return OT_SUCCESS;
+}
+
+#define SCENE_DIV_0_TO_1_CT(a)   (((a) == 0) ? 1 : (a))
+#define SCENE_MIN_CT(x, y) ((x) < (y)) ? (x) : (y)
+#define SCENE_MAX_CT(x, y) ((x) > (y)) ? (x) : (y)
+
+ot_s32 ot_scene_set_manual_wb_gain_by_ct(ot_vi_pipe_handle pipe_hdl, ot_s32 ct)
+{
+    // printf("%s enter, ct:%d\n",__FUNCTION__,ct);
+    ot_s32 ret;
+
+    ot_u32 p0;
+    ot_s32 p1, p2;
+    ot_s64 p3, p4;
+
+    ot_eis_vi_awb_attr wb_attr;
+    ret = ot_eis_vi_awb_get_attr(pipe_hdl, &wb_attr);
+    ot_scenecomm_check_return(ret, OT_SCENE_EINTER);
+
+    ot_s32 cp1 = wb_attr.auto_attr.curve_para[0];
+    ot_s32 cp2 = wb_attr.auto_attr.curve_para[1];
+    ot_s32 cp3 = wb_attr.auto_attr.curve_para[2];
+    ot_s64 cp4 = wb_attr.auto_attr.curve_para[3];
+    ot_s64 cp5 = wb_attr.auto_attr.curve_para[4];
+    ot_s64 cp6 = wb_attr.auto_attr.curve_para[5];
+    ot_u32 cp7 = wb_attr.auto_attr.static_wb[0];
+    ot_u32 cp8 = wb_attr.auto_attr.static_wb[3];
+
+    p3 = 0;
+    p4 = 0;
+    p0 = ct << 12;
+
+    if (p0 < (cp6 - (cp5 * cp5) / SCENE_DIV_0_TO_1_CT(cp4 << 2)) && (cp4 > 0)) {
+        p2 = (cp5 < 0) ? (-cp5 / SCENE_DIV_0_TO_1_CT(cp4 << 1)) : 1;
+    } else {
+        p3 = (ot_s64)(sqrt(cp4 * p0 + ((cp5 * cp5) >> 2) - cp4 * cp6)) / SCENE_DIV_0_TO_1_CT(cp4);
+        p4 = cp5 / SCENE_DIV_0_TO_1_CT(cp4 << 1);
+        if (p3 > p4) {
+            p2 = p3 - p4;
+        } else {
+            p2 = 1;
+        }
+    }
+
+    if (p2 == cp1) {
+        p2 = cp1 + 1;
+    }
+    p1 = SCENE_MAX_CT(1, ((cp2 << 8) - p2 * cp3) / SCENE_DIV_0_TO_1_CT(p2 - cp1));
+    p2 = SCENE_MAX_CT(1, p2);
+
+    ot_s32 rgain = SCENE_MIN_CT(1048575, ((ot_u32)cp7 << 16) / SCENE_DIV_0_TO_1_CT(p1));
+    ot_s32 bgain = SCENE_MIN_CT(1048575, ((ot_u32)cp8 << 16) / SCENE_DIV_0_TO_1_CT(p2));
+    ot_s32 ggain = (1 << 16);
+
+    //ot_u16
+    wb_attr.manual_attr.r_gain = rgain >> 8;
+    wb_attr.manual_attr.gr_gain = ggain >> 8;
+    wb_attr.manual_attr.gb_gain = ggain >> 8;
+    wb_attr.manual_attr.b_gain = bgain >> 8;
+
+    // printf("%s enter, rgain:%d, bgain:%d, ggain:%d\n",__FUNCTION__,rgain,bgain,ggain);
+
+    ret = ot_eis_vi_awb_set_attr(pipe_hdl, &wb_attr);
+    ot_scenecomm_check_return(ret, OT_SCENE_EINTER);
+
+    return OT_SUCCESS;
 }
 
 ot_s32 ot_scene_set_static_awb(ot_vi_pipe_handle pipe_hdl, ot_u8 index)
diff -Naur --no-dereference base_lq560v100.custom/main/src/component/media/sample/uvc_app/alsa_readme.txt lq560v100.custom/main/src/component/media/sample/uvc_app/alsa_readme.txt
--- base_lq560v100.custom/main/src/component/media/sample/uvc_app/alsa_readme.txt	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/main/src/component/media/sample/uvc_app/alsa_readme.txt	2026-06-15 11:54:05.175834452 +0800
@@ -0,0 +1,27 @@
+This document briefly describes how to port and use alsa-lib.
+
+1.download alsa-lib source code
+	Note: The alsa-lib source package is not released by default, only dynamic library files are released. The alsa-lib source package needs to be downloaded from the open source community.
+	Download the source code of alsa-lib v1.2.7 from the alsa-project open source community:
+	1) Go to the website: www.alsa-project.org
+	2) Select the http://www.alsa-project.org/main/index.php/Download option of the HTTP protocol resource to enter the subpage
+	3) Download alsa-lib-1.2.7.tar.bz2
+
+2.compile alsa-lib
+	1) Store the downloaded alsa-lib-1.2.7.tar.bz2 in the smp/a55_linux/source/mpp/sample/uvc_app/alsa/opensource directory.
+	2) In the linux server, enter the smp/a55_linux/source/mpp/sample/uvc_app/alsa/opensource directory and execute the following command:
+	tar -xjvf alsa-lib-1.2.7.tar.bz2
+	cd ./alsa-lib-1.2.7/
+	mkdir -p /home/install/alsa-lib-1.2.7/
+	./configure --host=aarch64-v01c01-linux-musl --prefix=/home/install/alsa-lib-1.2.7/ --enable-static=no --enable-shared=yes --with-configdir=/home/audio/alsa/ --disable-python
+	make
+	make install
+	cp -r /home/install/alsa-lib-1.2.7/lib/ ../../
+	cp -r /home/install/alsa-lib-1.2.7/include/ ../../
+
+	Note: The above command is used to generate the dynamic link library of alsa-lib. --host is used to specify the cross compiler, and it needs to be modified when using other cross-compilation toolchains. --prefix is used to specify the installation path of the compiled file. --enable-static is used to specify static library support. --enable-shared is used to specify dynamic library support. --with-configdir is used to specify the installation path of the config file (also the path of the config file on the board).
+
+3.install to the embedded platform
+	On the target board, the following files need to be copied to the corresponding location:
+	1) Copy the libasound.so.2 file in the /home/install/alsa-lib-1.2.7/lib/ directory on the server to the /lib64/ directory on the board.
+	2) Copy all the files in the /home/audio/alsa/ directory on the server to the /home/audio/alsa/ directory of the board (create it if it does not exist).
diff -Naur --no-dereference base_lq560v100.custom/main/src/component/media/sample/uvc_app/application.c lq560v100.custom/main/src/component/media/sample/uvc_app/application.c
--- base_lq560v100.custom/main/src/component/media/sample/uvc_app/application.c	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/main/src/component/media/sample/uvc_app/application.c	2026-08-25 20:32:55.299875173 +0800
@@ -0,0 +1,149 @@
+/*
+  Copyright (c), 2001-2024, Oritek Tech. Co., Ltd.
+ */
+
+#include <stdio.h>
+#include <signal.h>
+#include <string.h>
+#include <ctype.h>
+#include <stdlib.h>
+#include "camera.h"
+#include "frame_cache.h"
+#include "uvc_media.h"
+#include "uvc.h"
+#include "ot_smr.h"
+#include "uvc_dump.h"
+
+
+static ot_bool g_dump_enable = OT_FALSE;
+
+volatile sig_atomic_t g_need_quit_flag = 0;
+sig_atomic_t uvc_apps_get_quit_flag(void)
+{
+    return g_need_quit_flag;
+}
+
+static void uvc_apps_usage(const char *s_prg_nm)
+{
+    printf("Usage1 : %s -h\n", s_prg_nm);
+    printf("\t -h  --print help information\n");
+    printf("Usage2 : %s [DEVICE_COUNT] [st] [dump]\n", s_prg_nm);
+    printf("\t DEVICE_COUNT: max uvc device count, should in [1, 2] (default 1)\n");
+    printf("\t st : enable RAWDBG summary log once per second while host streaming\n");
+    printf("\t dump : enable RAW staged dump (default disabled)\n");
+}
+
+static void uvc_apps_handle_signal(int signo)
+{
+    if (signo == SIGINT || signo == SIGTERM) {
+        g_need_quit_flag = 1;
+    }
+
+#if defined UVC_STILL_IMAGE && defined UVC_STILL_BUTTON_TEST
+    if (signo == SIGUSR1) {
+        button_pressed();
+    }
+#endif
+}
+
+static ot_s32 uvc_apps_parse_args(int argc, char *argv[])
+{
+    uint32_t dev_cnt = 1;
+    ot_bool rawdbg_enable = OT_FALSE;
+    ot_bool dump_enable = OT_FALSE;
+    int i;
+
+    for (i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-h") == 0) {
+            return OT_FAILURE;
+        }
+        if (strcmp(argv[i], "st") == 0) { /* RAWDBG æ±‡æ€»æ—¥å¿—å¼€å…³ */
+            rawdbg_enable = OT_TRUE;
+            continue;
+        }
+        if (strcmp(argv[i], "dump") == 0) { /* RAW åˆ†é˜¶æ®µ dump å¼€å…³ */
+            dump_enable = OT_TRUE;
+            continue;
+        }
+        if (strlen(argv[i]) == 1 && isdigit(argv[i][0])) {
+            uint32_t v = strtoul(argv[i], OT_NULL, 10);
+            if (v == 0 || v > OT_UVC_MAX_CHN_NUM) {
+                printf("uvc device count invalid\n");
+                return OT_FAILURE;
+            }
+            dev_cnt = v;
+            continue;
+        }
+        printf("unknown argument: %s\n", argv[i]);
+        return OT_FAILURE;
+    }
+
+    uvc_set_rawdbg_enable(rawdbg_enable);
+    if (rawdbg_enable) {
+        printf("RAWDBG summary enabled (1 s interval)\n");
+    }
+    if (dump_enable) {
+        printf("RAW staged dump enabled\n");
+    }
+    g_dump_enable = dump_enable;
+
+    camera_set_uvc_device_cnt(dev_cnt);
+    printf("UVC device count %u\n", camera_get_uvc_device_cnt());
+
+    return OT_SUCCESS;
+}
+
+int main(int argc, char *argv[])
+{
+    int ret;
+
+    ret = uvc_apps_parse_args(argc, argv);
+    if (ret != OT_SUCCESS) {
+        uvc_apps_usage(argv[0]);
+        return 0;
+    }
+
+    struct sigaction act = {0};
+    act.sa_handler = uvc_apps_handle_signal;
+    sigemptyset(&act.sa_mask);
+    act.sa_flags = 0;
+    sigaction(SIGINT, &act, NULL);
+    sigaction(SIGTERM, &act, NULL);
+#if defined UVC_STILL_IMAGE && defined UVC_STILL_BUTTON_TEST
+    sigaction(SIGUSR1, &act, NULL);
+#endif
+
+    if (ot_smr_init() != 0) {
+        printf("ot_smr_init failed\n");
+        goto err;
+    }
+
+    uvc_dump_init(g_dump_enable);
+
+    if (create_uvc_cache(camera_get_uvc_device_cnt()) != 0) {
+        goto err;
+    }
+
+    if (get_g_uac_val() == 1) {
+        if (create_uac_cache() != 0) {
+            goto err;
+        }
+    }
+
+    if (get_ot_camera()->init() != 0 || get_ot_camera()->open() != 0 || get_ot_camera()->run() != 0) {
+        goto err;
+    }
+
+    printf("UVC sample exit!\n");
+
+err:
+    get_ot_camera()->close();
+    uvc_dump_deinit();
+    destroy_uvc_cache();
+    if (get_g_uac_val() == 1) {
+        destroy_uac_cache();
+    }
+
+    printf("exit app normally\n");
+    return 0;
+}
diff -Naur --no-dereference base_lq560v100.custom/main/src/component/media/sample/uvc_app/camera.c lq560v100.custom/main/src/component/media/sample/uvc_app/camera.c
