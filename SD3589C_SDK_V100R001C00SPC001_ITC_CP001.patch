+- [ ] **Step 7: å®ç° `uvc_dump_frame()`**
+
+```c
+int uvc_dump_frame(int dev_no, unsigned int frame_id,
+                   const ot_char *fmt_str, ot_u32 width, ot_u32 height,
+                   const unsigned char *data, ot_u32 size)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    char path[PATH_MAX];
+    FILE *fp;
+    size_t written;
+
+    if (!ctx->enabled || ctx->dumped_count >= ctx->dump_frames ||
+        data == NULL || size == 0) {
+        return 0;
+    }
+
+    (void)snprintf_s(path, sizeof(path), sizeof(path) - 1,
+                     "%s/%s_%d_RUN_%s_F%05u_%ux%u_%s.yuv",
+                     ctx->dump_dir, UVC_DUMP_NAME_PREFIX,
+                     dev_no, ctx->run_id, frame_id,
+                     width, height, fmt_str);
+
+    fp = fopen(path, "wb");
+    if (fp == NULL) {
+        printf("[UVC_DUMP] fopen %s failed: %m\n", path);
+        return -1;
+    }
+
+    written = fwrite(data, 1, size, fp);
+    (void)fclose(fp);
+
+    if (written != size) {
+        printf("[UVC_DUMP] fwrite %s failed: %zu/%u\n", path, written, size);
+        (void)unlink(path);
+        return -1;
+    }
+
+    ctx->dumped_count++;
+    printf("[UVC_DUMP] dev=%d frame=%05u %ux%u %s size=%u -> %s\n",
+           dev_no, frame_id, width, height, fmt_str, size, path);
+    return 0;
+}
+```
