@@ -0,0 +1,205 @@
+/*
+  Copyright (c), 2001-2024, Oritek Tech. Co., Ltd.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "uvc_prop_mgr.h"
+#include "cjson/cJSON.h"
+#include "ot_stream.h"
+
+#define DEF_EXPOSURE_ABS_TIME    (200) // Default exposure time for non-manual mode
+
+int uvc_properties_load(const char *json_file, uvc_properties_t *props)
+{
+    if (!json_file || !props) {
+        return -1;
+    }
+
+    FILE *fp = fopen(json_file, "r");
+    if (!fp) {
+        return -1;
+    }
+
+    fseek(fp, 0, SEEK_END);
+    long file_size = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+
+    char *json_str = (char *)malloc(file_size + 1);
+    if (!json_str) {
+        fclose(fp);
+        return -1;
+    }
+
+    size_t read_size = fread(json_str, 1, file_size, fp);
+    json_str[read_size] = '\0';
+    fclose(fp);
+
+    cJSON *root = cJSON_Parse(json_str);
+    free(json_str);
+
+    if (!root) {
+        return -1;
+    }
+
+    cJSON *properties = cJSON_GetObjectItem(root, "properties");
+    if (!properties) {
+        cJSON_Delete(root);
+        return -1;
+    }
+
+    
+    // Load Camera Terminal properties
+    cJSON *ct = cJSON_GetObjectItem(properties, "ct");
+    if (ct) {
+        props->exposure_auto_mode = (uint8_t)cJSON_GetNumberValue(cJSON_GetObjectItem(ct, "exposure_auto_mode"));
+        props->exposure_absolute_time = (props->exposure_auto_mode != 0x08) ? (uint32_t)cJSON_GetNumberValue(cJSON_GetObjectItem(ct, "exposure_absolute_time")) : DEF_EXPOSURE_ABS_TIME;   
+    }
+
+    // Load Processing Unit properties
+    cJSON *pu = cJSON_GetObjectItem(properties, "pu");
+    if (pu) {
+        props->backlight_compensation = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "backlight_compensation"));
+        props->brightness = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "brightness"));
+        props->contrast = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "contrast"));
+        props->hue = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "hue"));
+        props->saturation = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "saturation"));
+        props->sharpness = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "sharpness"));
+        props->gamma = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "gamma"));
+        props->white_balance_temperature_auto = (uint8_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "white_balance_temperature_auto"));
+        props->white_balance_temperature = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "white_balance_temperature"));
+        props->gain = (uint16_t)cJSON_GetNumberValue(cJSON_GetObjectItem(pu, "gain"));
+    }
+
+    cJSON_Delete(root);
+    return 0;
+}
+
+int uvc_properties_save(const char *json_file, const uvc_properties_t *props)
+{
+    if (!json_file || !props) {
+        return -1;
+    }
+
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return -1;
+    }
+
+    cJSON *properties = cJSON_AddObjectToObject(root, "properties");
+    if (!properties) {
+        cJSON_Delete(root);
+        return -1;
+    }
+
+    // Save Processing Unit properties
+    cJSON *pu = cJSON_AddObjectToObject(properties, "pu");
+    if (pu) {
+        cJSON_AddNumberToObject(pu, "backlight_compensation", props->backlight_compensation);
+        cJSON_AddNumberToObject(pu, "brightness", props->brightness);
+        cJSON_AddNumberToObject(pu, "contrast", props->contrast);
+        cJSON_AddNumberToObject(pu, "hue", props->hue);
+        cJSON_AddNumberToObject(pu, "saturation", props->saturation);
+        cJSON_AddNumberToObject(pu, "sharpness", props->sharpness);
+        cJSON_AddNumberToObject(pu, "gamma", props->gamma);
+        cJSON_AddNumberToObject(pu, "white_balance_temperature_auto", props->white_balance_temperature_auto);
+        cJSON_AddNumberToObject(pu, "white_balance_temperature", props->white_balance_temperature);
+        cJSON_AddNumberToObject(pu, "gain", props->gain);
+    }
+
+    // Save Camera Terminal properties
+    cJSON *ct = cJSON_AddObjectToObject(properties, "ct");
+    if (ct) {
+        cJSON_AddNumberToObject(ct, "exposure_auto_mode", props->exposure_auto_mode);
+        cJSON_AddNumberToObject(ct, "exposure_absolute_time", props->exposure_absolute_time);
+    }
+
+    char *json_str = cJSON_Print(root);
+    if (!json_str) {
+        cJSON_Delete(root);
+        return -1;
+    }
+
+    FILE *fp = fopen(json_file, "w");
+    if (!fp) {
+        free(json_str);
+        cJSON_Delete(root);
+        return -1;
+    }
+
+    fprintf(fp, "%s", json_str);
+    fclose(fp);
+
+    free(json_str);
+    cJSON_Delete(root);
+    return 0;
+}
+
+int uvc_properties_apply(uint32_t dev_no, const uvc_properties_t *props)
+{
+    if (!props) {
+        return -1;
+    }
+
+    // Apply Camera Terminal properties
+    camera_terminal_ops_st *ct_ops = get_ot_stream()->mpi_ct_ops;
+    if (ct_ops) {
+        ct_ops->exposure_auto_mode_set(dev_no, props->exposure_auto_mode);
+        if (props->exposure_auto_mode != 0x08) {
+            ct_ops->exposure_absolute_time_set(dev_no, props->exposure_absolute_time);
+        }
+    }
+
+    // Apply Processing Unit properties
+    processing_unit_ops_st *pu_ops = get_ot_stream()->mpi_pu_ops;
+    if (pu_ops) {
+        pu_ops->brightness_set(dev_no, props->brightness);
+        pu_ops->contrast_set(dev_no, props->contrast);
+        pu_ops->hue_set(dev_no, props->hue);
+        pu_ops->saturation_set(dev_no, props->saturation);
+        pu_ops->sharpness_set(dev_no, props->sharpness);
+        pu_ops->gamma_set(dev_no, props->gamma);
+        pu_ops->white_balance_temperature_auto_set(dev_no, props->white_balance_temperature_auto);
+        if (!props->white_balance_temperature_auto) {
+            pu_ops->white_balance_temperature_set(dev_no, props->white_balance_temperature);
+        }
+        
+        pu_ops->gain_set(dev_no, props->gain);
+        
+        pu_ops->backlight_compensation_set(dev_no, props->backlight_compensation);
+    }
+
+    return 0;
+}
+
+int uvc_properties_get_current(uint32_t dev_no, uvc_properties_t *props)
+{
+    if (!props) {
+        return -1;
+    }
+
+    // Get current Processing Unit properties
+    processing_unit_ops_st *pu_ops = get_ot_stream()->mpi_pu_ops;
+    if (pu_ops) {
+        props->backlight_compensation = pu_ops->backlight_compensation_get(dev_no);
+        props->brightness = pu_ops->brightness_get(dev_no);
+        props->contrast = pu_ops->contrast_get(dev_no);
+        props->hue = pu_ops->hue_get(dev_no);
+        props->saturation = pu_ops->saturation_get(dev_no);
+        props->sharpness = pu_ops->sharpness_get(dev_no);
+        props->gamma = pu_ops->gamma_get(dev_no);
+        props->white_balance_temperature_auto = pu_ops->white_balance_temperature_auto_get(dev_no);
+        props->white_balance_temperature      = pu_ops->white_balance_temperature_get(dev_no);
+        props->gain = pu_ops->gain_get(dev_no);
+    }
+
+    // Get current Camera Terminal properties
+    camera_terminal_ops_st *ct_ops = get_ot_stream()->mpi_ct_ops;
+    if (ct_ops) {
+        props->exposure_auto_mode = ct_ops->exposure_auto_mode_get(dev_no);
+        props->exposure_absolute_time = (props->exposure_auto_mode != 0x08) ? ct_ops->exposure_absolute_time_get(dev_no) : DEF_EXPOSURE_ABS_TIME;
+    }
+
+    return 0;
+}
