+    if (ret <= EOK) {
+        printf("snprintf_s fail! ret = 0x%x.\n", ret);
+        return OT_NULL;
+    }
+#endif /* end of #ifdef __LITEOS__ */
+    fd = fopen(file_name, "w+");
+    if (fd == OT_NULL) {
+        printf("%s: open file %s failed\n", __FUNCTION__, file_name);
+        return OT_NULL;
+    }
+    printf("open stream file:\"%s\" for uac capture ok\n", file_name);
+    return fd;
+}
