diff -Naur --no-dereference base_lq560v100.custom/main/src/platform/linux/LQ560_SDK_V100R001C00SPC018_UVC-FOLLOWPFN_CP0002.patch lq560v100.custom/main/src/platform/linux/LQ560_SDK_V100R001C00SPC018_UVC-FOLLOWPFN_CP0002.patch
--- base_lq560v100.custom/main/src/platform/linux/LQ560_SDK_V100R001C00SPC018_UVC-FOLLOWPFN_CP0002.patch	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/main/src/platform/linux/LQ560_SDK_V100R001C00SPC018_UVC-FOLLOWPFN_CP0002.patch	2026-07-01 00:01:12.181107744 +0800
@@ -0,0 +1,37 @@
+diff -Naur a/mm/frame_vector.c b/mm/frame_vector.c
+--- a/mm/frame_vector.c	2025-11-17 20:30:28.000000000 +0800
++++ b/mm/frame_vector.c	2026-06-30 02:38:33.000000000 +0800
+@@ -81,6 +81,32 @@
+ 			goto out;
+ 	}
+
++	/* PATCH (Oritek LQ560 RAW UVC): For VM_IO|VM_PFNMAP VMAs (e.g. SMR
++	 * carveout userptr), use follow_pfn to obtain physical pfns without
++	 * requiring struct pages. Restores pre-5.10 get_vaddr_frames behavior.
++	 * Safe: fsdax already rejected above; this embedded device has no fsdax. */
++	if (vma->vm_flags & (VM_IO | VM_PFNMAP)) {
++		unsigned long addr;
++
++		vec->got_ref = false;
++		vec->is_pfns  = true;
++		ret = 0;
++		for (addr = start; ret < nr_frames; addr += PAGE_SIZE) {
++			unsigned long pfn;
++
++			if (addr >= vma->vm_end)
++				break;
++			if (follow_pfn(vma, addr, &pfn)) {
++				ret = 0;
++				break;
++			}
++			vec->ptrs[ret] = (void *)pfn;
++			ret++;
++		}
++		if (ret > 0)
++			goto out;
++	}
++
+ 	vec->nr_frames = 0;
+
+ out:
+ 	if (locked)
