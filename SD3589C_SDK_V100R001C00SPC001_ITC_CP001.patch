+static ot_s32 sample_uvc_media_stream_init(uvc_media_ctx *ctx)
+{
+    ot_s32 ret = OT_SUCCESS;
+    ot_eis_img_size imgsz = { 0 };
+    ot_video_buffer_attr vrb_cfg;
+    int is_raw;
+
+    ot_eis_vi_vproc_mode_type vi_vp_mode = OT_EIS_VI_OFFLINE_VPROC_OFFLINE;
+
+    sample_comm_vi_get_default_vi_cfg(ctx->sns_type, &ctx->vi_cfg);
+    sample_comm_vi_get_size_by_sns_type(ctx->sns_type, &imgsz);
+
+    /* RAW é€šè·¯ç”¨ç˜¦èº« VRB(ä»… bayer dump æ± ), é¿å…ä¸ SMR å¸§ç¼“å­˜ä¸€èµ·æ’‘çˆ† media æ± ã€‚
+     * ä»… 8k6k(48m5)éœ€è¦:12m20/8m30 çš„ RAW å ç”¨æœ¬å°±åœ¨æ± å†…ã€‚ */
+    is_raw = sample_uvc_is_raw_fmt(&gs_venc_prop[ctx->dev_no]);
+
+    switch (ctx->sns_type) {
+    case SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT:
+        if (is_raw) {
+            sample_uvc_get_48m5_raw_vrb_cfg(imgsz.width, imgsz.height, &vrb_cfg);
+            printf("48m5 RAW lean VRB: cnt=%u blk0_size=%u\n",
+                   (unsigned int)vrb_cfg.cnt, (unsigned int)vrb_cfg.buf_blks[0].size);
+        } else {
+            sample_uvc_get_48m5_vrb_cfg(imgsz.width, imgsz.height, &vrb_cfg);
+        }
+        break;
+    case SONY_IMX582_MIPI_12M_20FPS_10BIT_DIRECT:
+        sample_uvc_get_12m20_vrb_cfg(imgsz.width, imgsz.height, &vrb_cfg);
+        break;
+    default:
+        vi_vp_mode = OT_EIS_VI_ONLINE_VPROC_OFFLINE;
+        sample_uvc_get_8m30_vrb_cfg(imgsz.width, imgsz.height, &vrb_cfg);
+        break;
+    }
+
+    if (sample_comm_sys_init(&vrb_cfg) != OT_SUCCESS) {
+        return OT_FAILURE;
+    }
+
+    if (sample_comm_sys_set_vi_vproc_init_cfg(vi_vp_mode) != OT_SUCCESS) {
+        goto sys_exit;
+    }
+    
+    ret = sample_comm_media_pipe_init(&ctx->media_pipe_hdl);
+    if (ret != OT_SUCCESS) {
+        sample_print("sample_comm_media_pipe_init failed\n");
+        goto sys_exit;
+    }
+
+    ret = sample_comm_vi_start_vi(&ctx->vi_cfg);
+    if (ret != OT_SUCCESS) {
+        sample_print("sample_comm_vi_start_vi failed, ret:0x%x\n", ret);
+        goto start_vi_failed;
+    }
+
+    ctx->vi_cfg.media_pipe_hdl = ctx->media_pipe_hdl;
+
+    sample_uvc_enable_vi_low_delay(vi_vp_mode, ctx->vi_cfg.pipe_info[0].pipe_hdl, ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl);
+
+    ctx->is_media_init = OT_TRUE;
+    
+    return OT_SUCCESS;
+
+start_vi_failed:
+    sample_comm_media_pipe_stop(ctx->media_pipe_hdl);
+sys_exit:
+    sample_comm_sys_exit();
+    return ret;
+}
