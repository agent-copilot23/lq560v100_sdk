+static ot_s32 sample_uvc_save_strm_to_cache(int dev_no, ot_eis_venc_stream* stream)
+{
+    // Attention, attention, attention: No time-consuming operations are allowed here, otherwise the image delay and stalling will occur.
+    // Suggestion: Use ringBuffer to save the stream.  The user needs to copy the stream into the ringBuffer and then manage the ringbuffer
+    frame_node_t *fnode = OT_NULL;
+    uvc_cache_t  *c_uvc_cache = uvc_cache_get(dev_no);
+    if (c_uvc_cache != OT_NULL) {
+        get_node_from_queue(c_uvc_cache->free_queue, &fnode);
+    } 
+    else {
+        printf("(%s %d) no uvc cache!!!\n", __FUNCTION__,__LINE__);
+        return OT_FAILURE;
+    }
+
+    if (fnode != NULL) {
+        ot_u32 n = (stream->stream_lens <= fnode->length) ? stream->stream_lens : fnode->length;
+        memcpy(fnode->mem, stream->stream_virt_addr, n);
+        fnode->used = n;
+        put_node_to_queue(c_uvc_cache->ok_queue, fnode);
+    }
+
+    return OT_SUCCESS;
+}
