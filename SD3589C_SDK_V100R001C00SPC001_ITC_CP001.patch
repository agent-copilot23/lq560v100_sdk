+        ret = get_ot_stream()->mpi_sc_ops->startup(dev_no);
+    }
+
+    if (ret == 0) {
+        get_ot_stream()->streaming[dev_no] = 1;
+    }
+    return ret;
+}
+
+int ot_stream_shutdown(ot_u32 dev_no)
+{
