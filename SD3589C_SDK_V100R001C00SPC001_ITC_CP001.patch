+}
+static ot_s32 cmos_get_vi_alg_default(ot_vi_pipe_id vi_pipe, ot_eis_vi_sns_alg_default *isp_def)
+{
+    ot_eis_sns_state *sns_state = OT_NULL;
+
+    sns_check_pointer_return(isp_def);
+    imx582_sensor_get_ctx(vi_pipe, sns_state);
