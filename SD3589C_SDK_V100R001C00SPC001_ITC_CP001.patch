+uac_cache_t *uac_cache_get(void);
+
+int put_node_to_queue(frame_queue_t *q, frame_node_t *node);
+int get_node_from_queue(frame_queue_t *q, frame_node_t **node);
+unsigned int uvc_queue_count(const frame_queue_t *q);  /* è°ƒè¯•: è¯»é˜Ÿåˆ—èŠ‚ç‚¹æ•°(æ— é”,best-effort) */
+
+/* RAWDBG æ±‡æ€»è¾“å‡ºå¼€å…³: ä»…å½“ uvc_app ä¼ å…¥ st å‚æ•°æ—¶å¼€å¯; é—´éš”å›ºå®š 1 ç§’ */
