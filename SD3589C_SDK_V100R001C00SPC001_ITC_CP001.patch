+static ot_u32 clamp(ot_u32 val, ot_u32 min, ot_u32 max)
+{
+    ot_u32 res = val;
+    if (res < min) {
+        return min;
+    }
+    if (res > max) {
+        return max;
+    }
+    return val;
+}
