+            echo "333333" > $2/720p/dwDefaultFrameInterval
+            echo "442368000" > $2/720p/dwMaxBitRate
+            if [ $3 -eq 1 ]; then
+                echo "1843200" > $2/720p/dwMaxVideoFrameBufferSize
+            fi
+			            echo "442368000" > $2/720p/dwMinBitRate
+            echo "720" > $2/720p/wHeight
+            echo "1280" > $2/720p/wWidth
+            ;;
+        "1080p")
+            mkdir $2/1080p/
+            echo -e "333333"> $2/1080p/dwFrameInterval
+            echo "333333" > $2/1080p/dwDefaultFrameInterval
+            echo "995328000" > $2/1080p/dwMaxBitRate
+            if [ $3 -eq 1 ]; then
+                echo "4147200" > $2/1080p/dwMaxVideoFrameBufferSize
+            fi
+            echo "995328000" > $2/1080p/dwMinBitRate
+            echo "1080" > $2/1080p/wHeight
+            echo "1920" > $2/1080p/wWidth
+            ;;
+        "1440p")
+            mkdir $2/1440p/
+            echo -e "333333" > $2/1440p/dwFrameInterval
+            echo "333333" > $2/1440p/dwDefaultFrameInterval
+            echo "1990656000" > $2/1440p/dwMaxBitRate
+            if [ $3 -eq 1 ]; then
+                echo "8294400" > $2/1440p/dwMaxVideoFrameBufferSize
+            fi
+            echo "1990656000" > $2/1440p/dwMinBitRate
+            echo "1440" > $2/1440p/wHeight
+            echo "2560" > $2/1440p/wWidth
+            ;;
+        "2160p")
+            mkdir $2/2160p/
+            echo -e "333333" > $2/2160p/dwFrameInterval
+            echo "333333" > $2/2160p/dwDefaultFrameInterval
+            echo "3981312000" > $2/2160p/dwMaxBitRate
+            if [ $3 -eq 1 ]; then
+                echo "16588800" > $2/2160p/dwMaxVideoFrameBufferSize
+            fi
+            echo "3981312000" > $2/2160p/dwMinBitRate
+            echo "2160" > $2/2160p/wHeight
+            echo "3840" > $2/2160p/wWidth
+            ;;
+        *)
+            echo "$4 $i is invalid!"
+            ;;
+        esac
+    done
+}
+
+######################################################
+# set_format()  fill format
+# no argument
+#######################################################
+function set_format()
+{
+    #YUV
+    if [ -n "$YUYV" ]; then
+        echo "Add YUYV..."
+        mkdir streaming/uncompressed/yuyv/
+        echo -en "\x59\x55\x59\x32\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71" > streaming/uncompressed/yuyv/guidFormat
+        echo 16 > streaming/uncompressed/yuyv/bBitsPerPixel
+        set_resolution "$YUYV" streaming/uncompressed/yuyv/ 1 "YUYV"
+        ln -s streaming/uncompressed/yuyv/ streaming/header/h/
+        echo -e "Added YUYV\n"
+    fi
+    #NV21
+    if [ -n "$NV21" ]; then
+        echo "Add NV21..."
+        mkdir streaming/uncompressed/nv21/
+        echo -en "\x4E\x56\x32\x31\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71" > streaming/uncompressed/nv21/guidFormat
+        echo 12 > streaming/uncompressed/nv21/bBitsPerPixel
+        set_resolution "$NV21" streaming/uncompressed/nv21/ 1 "NV21"
+        ln -s streaming/uncompressed/nv21/ streaming/header/h/
+        echo -e "Added NV21\n"
+    fi
+    #NV12
+    if [ -n "$NV12" ]; then
+        echo "Add NV12..."
+        mkdir streaming/uncompressed/nv12/
+        echo -en "\x4E\x56\x31\x32\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71" > streaming/uncompressed/nv12/guidFormat
+        echo 12 > streaming/uncompressed/nv12/bBitsPerPixel
+        set_resolution "$NV12" streaming/uncompressed/nv12/ 1 "NV12"
+        ln -s streaming/uncompressed/nv12/ streaming/header/h/
+        echo -e "Added NV12\n"
+    fi
+    #MJPEG
+    if [ -n "$MJPEG" ]; then
+        echo "Add MJPEG..."
+        mkdir streaming/mjpeg/m/
+        set_resolution "$MJPEG" streaming/mjpeg/m/ 1 "MJPEG"
+        ln -s streaming/mjpeg/m/ streaming/header/h/
+        echo -e "Added MJPEG\n"
+    fi
+    #H264
+    if [ -n "$H264" ]; then
+        echo "Add H264..."
+        mkdir streaming/framebased/h264/
+        echo -en "\x48\x32\x36\x34\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71" > streaming/framebased/h264/guidFormat
+        set_resolution "$H264" streaming/framebased/h264/ 0 "H264"
+        ln -s streaming/framebased/h264/ streaming/header/h/
+        echo -e "Added H264\n"
+    fi
+    #HEVC aka H265
+    if [ -n "$H265" ]; then
+        echo "Add HEVC(H265)..."
+        mkdir streaming/framebased/h265/
+        echo -en "\x48\x32\x36\x35\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71" > streaming/framebased/h265/guidFormat
+        set_resolution "$H265" streaming/framebased/h265/ 0 "HEVC(H265)"
+        ln -s streaming/framebased/h265/ streaming/header/h/
+        echo -e "Added HEVC(H265)\n"
+    fi
+}
+
+mount -t configfs none /sys/kernel/config/
+cd /sys/kernel/config/usb_gadget/
+mkdir camera
+cd camera
+echo "0x01" > bDeviceProtocol
+echo "0x02" > bDeviceSubClass
+echo "0xEF" > bDeviceClass
+echo $VID > idVendor
+echo $PID > idProduct
+mkdir strings/0x409
+echo $MANUFACTURER > strings/0x409/manufacturer
+echo $PRODUCT > strings/0x409/product
+echo $SERIALNUMBER > strings/0x409/serialnumber
+
+make_function()
+{
+    mkdir functions/uvc.usb${1}
+    cd functions/uvc.usb${1}
+    mkdir control/header/h/
+    echo $BCDUVC > control/header/h/bcdUVC
+    echo "48000000" > control/header/h/dwClockFrequency
+    ln -s control/header/h/ control/class/fs/
+    ln -s control/header/h/ control/class/ss/
+
+cat <<EOF> control/terminal/camera/default/bmControls
+$CamControl1
+$CamControl2
+$CamControl3
+EOF
+cat <<EOF> control/processing/default/bmControls
+$ProcControl1
+$ProcControl2
+$ProcControl3
+EOF
+cat <<EOF> control/encoding/default/bmControls
+$EcdControl1
+$EcdControl2
+$EcdControl3
+EOF
+cat <<EOF> control/encoding/default/bmControlsRuntime
+$EcdRtControl1
+$EcdRtControl2
+$EcdRtControl3
+EOF
+cat <<EOF> control/extension/default/bmControls
+$ExtControl1
+$ExtControl2
+EOF
+
+    mkdir streaming/header/h/
+    set_format
+    ln -s streaming/header/h/ streaming/class/fs/
+    ln -s streaming/header/h/ streaming/class/hs/
+    ln -s streaming/header/h/ streaming/class/ss/
+    if [ "$TransferMode" == "bulk" ];then
+        echo -e "setting mode to bulk"
+        echo "bulk" > streaming_transfer
+        echo 32768 > streaming_maxpacket
+        echo 15 > streaming_maxburst
+    else
+        echo -e "setting mode to isoc"
+        echo "isoc" > streaming_transfer
+        echo 1024 > streaming_maxpacket
+    fi
+    if [ "$PerfMode" == "v4l2" ]; then
+        echo "v4l2" > performance_mode
+    fi
+    #-Create and setup configuration
+    cd ../../
+}
+
+for i in `seq 0 $(expr ${UVC_DEVICE_CNT} - 1)` ; do
+    make_function $i
+done
+
+# UAC
+#mkdir functions/uac1.usb0
+#echo 8 > functions/uac1.usb0/req_number
+
+mkdir configs/c.1/
+echo "0x01" > configs/c.1/MaxPower
+echo "0xc0" > configs/c.1/bmAttributes
+mkdir configs/c.1/strings/0x409/
+echo "Config  1" > configs/c.1/strings/0x409/configuration
+for i in `seq 0 $(expr ${UVC_DEVICE_CNT} - 1)` ; do
+    ln -s functions/uvc.usb${i}/ configs/c.1/
+done
+#ln -s functions/uac1.usb0/ configs/c.1/
+echo "$(ls /sys/class/udc)" > UDC
diff -Naur --no-dereference base_lq560v100.custom/main/src/component/media/sample/uvc_app/uvc_dump.c lq560v100.custom/main/src/component/media/sample/uvc_app/uvc_dump.c
--- base_lq560v100.custom/main/src/component/media/sample/uvc_app/uvc_dump.c	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/main/src/component/media/sample/uvc_app/uvc_dump.c	2026-08-25 20:32:55.303875186 +0800
@@ -0,0 +1,306 @@
+/*
+  Copyright (c), 2001-2024, Oritek Tech. Co., Ltd.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <limits.h>
+#include <time.h>
+
+#include "uvc_dump.h"
+#include "securec.h"
+
+#define UVC_DUMP_DEFAULT_DIR    "dump"
+#define UVC_DUMP_DEFAULT_FRAMES 2
+#define UVC_DUMP_DEFAULT_SKIP   5
+#define UVC_DUMP_RUN_ID_LEN     32
+#define UVC_DUMP_CROP_WIDTH     800
+#define UVC_DUMP_CROP_HEIGHT    600
+
+typedef struct {
+    char run_id[UVC_DUMP_RUN_ID_LEN];
+    char dump_dir[PATH_MAX];
+    unsigned int dump_frames;
+    unsigned int skip_frames;
+    unsigned int seen_frames;
+    unsigned int committed_frames;
+    unsigned int dumped_files;
+    unsigned int begin_calls;
+    int enabled;
+} uvc_dump_ctx_t;
+
+static uvc_dump_ctx_t g_uvc_dump_ctx = {0};
+
+static unsigned int uvc_dump_get_uint_env(const char *name, unsigned int default_val)
+{
+    const char *v = getenv(name);
+    if (v == NULL) {
+        return default_val;
+    }
+    return (unsigned int)strtoul(v, NULL, 10);
+}
+
+static const char *uvc_dump_get_str_env(const char *name, const char *default_val)
+{
+    const char *v = getenv(name);
+    return v ? v : default_val;
+}
+
+static void uvc_dump_make_run_id(char *out, size_t out_len)
+{
+    time_t now = time(NULL);
+    struct tm *tm_info = localtime(&now);
+    if (tm_info == NULL) {
+        (void)snprintf_s(out, out_len, out_len - 1, "00000000000000");
+        return;
+    }
+    (void)snprintf_s(out, out_len, out_len - 1,
+                     "%04d%02d%02d%02d%02d%02d",
+                     tm_info->tm_year + 1900, tm_info->tm_mon + 1, tm_info->tm_mday,
+                     tm_info->tm_hour, tm_info->tm_min, tm_info->tm_sec);
+}
+
+static int uvc_dump_ensure_dir(const char *dir)
+{
+    struct stat st;
+    if (stat(dir, &st) == 0 && S_ISDIR(st.st_mode)) {
+        return 0;
+    }
+    if (mkdir(dir, 0755) == 0) {
+        return 0;
+    }
+    printf("[UVC_DUMP] mkdir %s failed: %m\n", dir);
+    return -1;
+}
+
+static int uvc_dump_get_exe_dir(char *dir, size_t dir_len)
+{
+    char exe_path[PATH_MAX];
+    ssize_t len;
+    char *slash;
+
+    len = readlink("/proc/self/exe", exe_path, sizeof(exe_path) - 1);
+    if (len <= 0 || (size_t)len >= sizeof(exe_path)) {
+        return -1;
+    }
+    exe_path[len] = '\0';
+    slash = strrchr(exe_path, '/');
+    if (slash == NULL) {
+        return -1;
+    }
+    *slash = '\0';
+    if (strncpy_s(dir, dir_len, exe_path, dir_len - 1) != 0) {
+        return -1;
+    }
+    return 0;
+}
+
+static int uvc_dump_make_dir_path(char *out, size_t out_len, const char *dir)
+{
+    char exe_dir[PATH_MAX];
+
+    if (dir[0] == '/') {
+        return snprintf_s(out, out_len, out_len - 1, "%s", dir) < 0 ? -1 : 0;
+    }
+    if (uvc_dump_get_exe_dir(exe_dir, sizeof(exe_dir)) != 0) {
+        return snprintf_s(out, out_len, out_len - 1, "%s", dir) < 0 ? -1 : 0;
+    }
+    return snprintf_s(out, out_len, out_len - 1, "%s/%s", exe_dir, dir) < 0 ? -1 : 0;
+}
+
+int uvc_dump_init(ot_bool enable)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    const char *dump_dir = uvc_dump_get_str_env("UVC_DUMP_DIR", UVC_DUMP_DEFAULT_DIR);
+
+    (void)memset_s(ctx, sizeof(*ctx), 0, sizeof(*ctx));
+    if (!enable) {
+        return 0;
+    }
+
+    ctx->dump_frames = uvc_dump_get_uint_env("UVC_DUMP_FRAMES", UVC_DUMP_DEFAULT_FRAMES);
+    ctx->skip_frames = uvc_dump_get_uint_env("UVC_DUMP_SKIP", UVC_DUMP_DEFAULT_SKIP);
+    if (ctx->dump_frames == 0) {
+        return 0;
+    }
+
+    if (uvc_dump_make_dir_path(ctx->dump_dir, sizeof(ctx->dump_dir), dump_dir) != 0) {
+        printf("[UVC_DUMP] dump dir too long\n");
+        return -1;
+    }
+    if (uvc_dump_ensure_dir(ctx->dump_dir) != 0) {
+        return -1;
+    }
+
+    uvc_dump_make_run_id(ctx->run_id, sizeof(ctx->run_id));
+    ctx->enabled = 1;
+    printf("###UVC_DUMP_START### dir=%s run=%s skip=%u frames=%u crop=%ux%u\n",
+           ctx->dump_dir, ctx->run_id, ctx->skip_frames, ctx->dump_frames,
+           UVC_DUMP_CROP_WIDTH, UVC_DUMP_CROP_HEIGHT);
+    return 0;
+}
+
+void uvc_dump_deinit(void)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    if (ctx->enabled) {
+        printf("[UVC_DUMP] dumped %u files to %s\n", ctx->dumped_files, ctx->dump_dir);
+    }
+    ctx->enabled = 0;
+}
+
+ot_bool uvc_dump_is_enabled(void)
+{
+    return g_uvc_dump_ctx.enabled ? OT_TRUE : OT_FALSE;
+}
+
+int uvc_dump_begin_frame(unsigned int *sample_id)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+
+    if (sample_id == NULL) {
+        return -1;
+    }
+    *sample_id = 0;
+    ctx->begin_calls++;
+    if (!ctx->enabled) {
+        if (ctx->begin_calls <= 3) {
+            printf("[UVC_DUMP_SAMPLE] disabled call=%u\n", ctx->begin_calls);
+        }
+        return 0;
+    }
+    if (ctx->seen_frames < ctx->skip_frames) {
+        ctx->seen_frames++;
+        if (ctx->seen_frames <= ctx->skip_frames) {
+            printf("[UVC_DUMP_SAMPLE] skip=%u/%u\n", ctx->seen_frames, ctx->skip_frames);
+        }
+        return 0;
+    }
+    if (ctx->committed_frames >= ctx->dump_frames) {
+        return 0;
+    }
+
+    *sample_id = ctx->committed_frames + 1;
+    printf("[UVC_DUMP_SAMPLE] candidate=%u seen=%u skip=%u committed=%u/%u\n",
+           *sample_id, ctx->seen_frames, ctx->skip_frames,
+           ctx->committed_frames, ctx->dump_frames);
+    return 1;
+}
+
+void uvc_dump_commit_frame(unsigned int sample_id)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+
+    if (!ctx->enabled || sample_id == 0 || sample_id != ctx->committed_frames + 1 ||
+        ctx->committed_frames >= ctx->dump_frames) {
+        return;
+    }
+    ctx->committed_frames++;
+    printf("[UVC_DUMP_SAMPLE] committed=%u/%u\n",
+           ctx->committed_frames, ctx->dump_frames);
+}
+
+static int uvc_dump_write_crop(const unsigned char *data, ot_u32 data_size,
+                               ot_u32 src_stride, ot_u32 row_bytes,
+                               ot_u32 src_width, ot_u32 src_height,
+                               const char *path, ot_u32 *written_size)
+{
+    FILE *fp;
+    size_t written;
+    ot_u64 last_row_end;
+
+    if (data == NULL || data_size == 0 || src_stride == 0 || row_bytes == 0 ||
+        src_width < UVC_DUMP_CROP_WIDTH || src_height < UVC_DUMP_CROP_HEIGHT ||
+        src_stride < row_bytes) {
+        return -1;
+    }
+
+    last_row_end = (ot_u64)(UVC_DUMP_CROP_HEIGHT - 1) * src_stride + row_bytes;
+    if (last_row_end > data_size) {
+        printf("[UVC_DUMP] crop exceeds source: size=%u stride=%u row_bytes=%u\n",
+               data_size, src_stride, row_bytes);
+        return -1;
+    }
+
+    fp = fopen(path, "wb");
+    if (fp == NULL) {
+        printf("[UVC_DUMP] fopen %s failed: %m\n", path);
+        return -1;
+    }
+
+    for (ot_u32 row = 0; row < UVC_DUMP_CROP_HEIGHT; row++) {
+        written = fwrite(data + (ot_u64)row * src_stride, 1, row_bytes, fp);
+        if (written != row_bytes) {
+            printf("[UVC_DUMP] fwrite %s row=%u failed: %zu/%u\n",
+                   path, row, written, row_bytes);
+            (void)fclose(fp);
+            (void)unlink(path);
+            return -1;
+        }
+    }
+    (void)fclose(fp);
+    *written_size = row_bytes * UVC_DUMP_CROP_HEIGHT;
+    return 0;
+}
+
+int uvc_dump_frame_stage(int dev_no, unsigned int sample_id,
+                         const ot_char *stage, const ot_char *bits,
+                         const ot_char *bayer, ot_u32 src_width, ot_u32 src_height,
+                         ot_u32 src_stride, const unsigned char *data, ot_u32 size)
+{
+    uvc_dump_ctx_t *ctx = &g_uvc_dump_ctx;
+    char path[PATH_MAX];
+    ot_u32 row_bytes;
+    ot_u32 bytes_per_pixel;
+    ot_u32 written_size = 0;
+    int ret;
+
+    if (!ctx->enabled || sample_id == 0 || sample_id > ctx->dump_frames ||
+        stage == NULL || bits == NULL || bayer == NULL || data == NULL || size == 0) {
+        if (ctx->enabled && sample_id != 0) {
+            printf("[UVC_DUMP_STAGE_SKIP] sample=%u stage=%s bits=%s data=%p size=%u\n",
+                   sample_id, stage ? stage : "null", bits ? bits : "null", data, size);
+        }
+        return 0;
+    }
+
+    bytes_per_pixel = (strcmp(bits, "10bits") == 0) ? 1 : 2;
+    row_bytes = (strcmp(bits, "10bits") == 0) ?
+                ((UVC_DUMP_CROP_WIDTH * 10 + 7) / 8) :
+                (UVC_DUMP_CROP_WIDTH * bytes_per_pixel);
+    ret = snprintf_s(path, sizeof(path), sizeof(path) - 1,
+                     "%s/%ux%u_%s_%s_%s_%s_%02u.raw",
+                     ctx->dump_dir, UVC_DUMP_CROP_WIDTH, UVC_DUMP_CROP_HEIGHT,
+                     bits, bayer, stage, ctx->run_id, sample_id);
+    if (ret < 0) {
+        printf("[UVC_DUMP] path too long\n");
+        return -1;
+    }
+
+    printf("[UVC_DUMP_BEGIN] dev=%d sample=%02u stage=%s bits=%s src=%ux%u stride=%u crop=%ux%u path=%s\n",
+           dev_no, sample_id, stage, bits, src_width, src_height, src_stride,
+           UVC_DUMP_CROP_WIDTH, UVC_DUMP_CROP_HEIGHT, path);
+
+    if (uvc_dump_write_crop(data, size, src_stride, row_bytes, src_width,
+                            src_height, path, &written_size) != 0) {
+        return -1;
+    }
+
+    ctx->dumped_files++;
+    printf("[UVC_DUMP_DONE] dev=%d sample=%02u stage=%s bits=%s size=%u -> %s\n",
+           dev_no, sample_id, stage, bits, written_size, path);
+    return 0;
+}
+
+int uvc_dump_frame(int dev_no, unsigned int frame_id,
+                   const ot_char *fmt_str, ot_u32 width, ot_u32 height,
+                   const unsigned char *data, ot_u32 size)
+{
+    (void)fmt_str;
+    return uvc_dump_frame_stage(dev_no, frame_id, "legacy", "16bits", "RGGB",
+                                width, height, width * 2, data, size);
+}
