+        (uvc_dev->dw_fcc == VIDEO_IMG_FORMAT_H264) ||
+        (uvc_dev->dw_fcc == VIDEO_IMG_FORMAT_H265))
+    {
+        ot_uvc_get_buf_size(uvc_dev, uvc_dev->dw_width, uvc_dev->dw_height, uvc_dev->dw_fcc, &v_fmt.fmt.pix.dw_size);
