+} uvc_cache_t;
+
+typedef struct uac_cache_t {
+    frame_queue_t *ok_queue;
+    frame_queue_t *free_queue;
+} uac_cache_t;
+
+int uvc_frame_nodes_alloc(uvc_cache_t* uvc_cache, unsigned int frame_size, int use_smr);
+int uvc_frame_nodes_free(uvc_cache_t* uvc_cache);
+
+int free_cache_node_list(frame_queue_t *queue);
+int create_cache_node_list(frame_queue_t *q, unsigned int buffer_size, int cache_count, int use_smr);
