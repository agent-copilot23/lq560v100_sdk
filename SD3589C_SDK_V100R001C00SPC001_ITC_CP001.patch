+static ot_s32 sample_uvc_yuv422sp_to_yuyv(ot_eis_img_frame *img, unsigned char *dst_buf, unsigned int dst_siz)
+{
+    ot_u8 *y_addr = OT_NULL, *c_addr = OT_NULL;
+    ot_u32 buf_size = img->buff.stride[0] * img->attr.height + img->buff.stride[1] * img->attr.height;
+    ot_u32 c_offset = img->buff.phys_addr[1] - img->buff.phys_addr[0];
+
+    if (buf_size > dst_siz) {
+        return OT_FAILURE;
+    }
+
+    ot_s32 ret = ot_smr_mmap(img->buff.phys_addr[0], buf_size, OT_TRUE, (ot_void *)&y_addr);
+    if (ret != OT_SUCCESS || y_addr == OT_NULL) {
+        sample_print("mmap phys 0x%llx size %d error \n", img->buff.phys_addr[0], buf_size);
+        return OT_FAILURE;
+    }
+
+    c_addr = y_addr + c_offset;
+    
+    ot_u8 *y, *c, *d;
+    for (ot_u32 i = 0; i < img->attr.height; i++) {
+        d = dst_buf + i * img->buff.stride[0] * 2;
+        y = y_addr  + i * img->buff.stride[0];
+        c = c_addr  + i * img->buff.stride[1];
+
+        for (ot_u32 j = 0; j < img->attr.width / 4; j++) {
+            *d++ = *y++; // Y
+            *d++ = *c++; // U
+            *d++ = *y++; // Y
+            *d++ = *c++; // V
+
+            *d++ = *y++; // Y
+            *d++ = *c++; // U
+            *d++ = *y++; // Y
+            *d++ = *c++; // V
+        }
+    }
+
+    ot_smr_munmap(y_addr, buf_size);
+
+    return OT_SUCCESS;
+}
+
+static ot_s32 sample_uvc_yuv420sp_to_nv12(ot_eis_img_frame *img, unsigned char *dst_buf, unsigned int dst_siz)
+{
+    ot_u8 *y_addr = OT_NULL, *c_addr = OT_NULL;
+    ot_u32 buf_size = img->buff.stride[0] * img->attr.height + img->buff.stride[1] * img->attr.height;
+    ot_u32 c_offset = img->buff.phys_addr[1] - img->buff.phys_addr[0];
+
+    if (buf_size > dst_siz) {
+        return OT_FAILURE;
+    }
+
+    ot_s32 ret = ot_smr_mmap(img->buff.phys_addr[0], buf_size, OT_FALSE, (ot_void *)&y_addr);
+    if (ret != OT_SUCCESS || y_addr == OT_NULL) {
+        sample_print("mmap phys 0x%llx size %d error \n", img->buff.phys_addr[0], buf_size);
+        return OT_FAILURE;
+    }
+    
+    ot_u8 *y, *c, *d;
+    for (ot_u32 i = 0; i < img->attr.height; i++) {
+        d = dst_buf + i * img->buff.stride[0];
+        y = y_addr  + i * img->buff.stride[0];
+
+        for (ot_u32 j = 0; j < img->attr.width; j++) {
+            memcpy(d, y, img->attr.width);
+        }
+    }
+
+    c_addr  = y_addr + c_offset;
+    dst_buf = dst_buf + c_offset;
+    for (ot_u32 i = 0; i < img->attr.height / 2; i++) {
+        d = dst_buf + i * img->buff.stride[1];
+        c = c_addr  + i * img->buff.stride[1];
+
+        for (ot_u32 j = 0; j < img->attr.width; j++) {
+            memcpy(d, c, img->attr.width);
+        }
+    }
+
+    ot_smr_munmap(y_addr, buf_size);
+
+    return OT_SUCCESS;
+}
