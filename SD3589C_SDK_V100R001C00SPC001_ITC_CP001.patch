+++ lq560v100.custom/main/src/component/media/sample/uvc_app/camera.c	2026-06-15 11:54:05.175834452 +0800
@@ -0,0 +1,158 @@
+/*
+  Copyright (c), 2001-2024, Oritek Tech. Co., Ltd.
+ */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <memory.h>
+#include <string.h>
+#include <pthread.h>
+#include <unistd.h>
+#include "ot_uvc.h"
+#include "ot_uac.h"
+#include "ot_stream.h"
+#include "ot_audio.h"
+#include "camera.h"
+#include "ot_eis_type.h"
+/* -------------------------------------------------------------------------- */
+
+ot_bool g_uac = OT_TRUE;
+static pthread_t g_st_uvc_pid[OT_UVC_MAX_CHN_NUM];
+static pthread_t g_st_uac_pid;
+static uint32_t  g_uvc_dev_cnt = 1;
+
+int camera_set_uvc_device_cnt(uint32_t dev_cnt)
+{
+    if (dev_cnt <= OT_UVC_MAX_CHN_NUM) {
+        g_uvc_dev_cnt = dev_cnt;
+        return 0;
+    }
+    return -1;
+}
+
+uint32_t camera_get_uvc_device_cnt(void)
+{
+    return g_uvc_dev_cnt;
+}
+
+static int camera_init(void)
+{
+    camera_register_uvc_mpi_ops();
+
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        if (get_ot_uvc()->init(i) != 0) {
+            return -1;
+        }
+    }
+
+    if (ot_stream_init() != 0) {
+        return -1;
+    }
+
+    if (g_uac) {
+#ifdef OT_UAC_COMPILE
+        camera_register_uac_mpi_ops();
+#endif
+
+        if (get_ot_uac()->init() != 0 || ot_audio_init() != 0) {
+            return -1;
+        }
+    }
+
+    return 0;
+}
+
+static int camera_open(void)
+{
+#ifdef OT_UVC_COMPILE
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        if (get_ot_uvc()->open(i) != 0) {
+            return -1;
+        }
+    }
+#endif
+
+    if (g_uac) {
+        if (get_ot_uac()->open() != 0) {
+            return -1;
+        }
+    }
+
+    return 0;
+}
+
+static int camera_close(void)
+{
+#ifdef OT_UVC_COMPILE
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        get_ot_uvc()->close(i);
+    }
+#endif
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        ot_stream_shutdown(i);
+    }
+    if (g_uac) {
+        get_ot_uac()->close();
+        ot_audio_shutdown();
+    }
+    ot_stream_deinit();
+    return 0;
+}
+
+static void *uvc_thread(void *p)
+{
+#ifdef OT_UVC_COMPILE
+    get_ot_uvc()->run((uint32_t)p);
+#endif
+    return NULL;
+}
+
+static void *uac_thread(void *p)
+{
+    get_ot_uac()->run();
+    return NULL;
+}
+
+static int camera_run(void)
+{
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        pthread_create(&g_st_uvc_pid[i], 0, uvc_thread, (void *)i);
+    }
+    pthread_create(&g_st_uac_pid, 0, uac_thread, NULL);
+
+#ifndef OT_UVC_COMPILE
+    while (OT_TRUE) {
+        if (uvc_apps_get_quit_flag() != 0) {
+            break;
+        }
+        usleep(10 * 1000); /* 10 * 1000us sleep */
+    }
+#endif
+
+    for (ot_u32 i = 0; i < g_uvc_dev_cnt; i++) {
+        pthread_join(g_st_uvc_pid[i], NULL);
+    }
+    pthread_join(g_st_uac_pid, NULL);
+    return 0;
+}
+
+/* -------------------------------------------------------------------------- */
+
+static ot_camera g_ot_camera = {
+    .init = camera_init,
+    .open = camera_open,
+    .close = camera_close,
+    .run = camera_run,
+};
+
+ot_camera *get_ot_camera(void)
+{
+    return &g_ot_camera;
+}
+
+void release_ot_camera(ot_camera *camera) {}
+
+unsigned int get_g_uac_val(void)
+{
+    return g_uac;
+}
