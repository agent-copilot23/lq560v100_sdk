diff -Naur --no-dereference base_lq560v100.custom/host_capture/split_yuv.py lq560v100.custom/host_capture/split_yuv.py
--- base_lq560v100.custom/host_capture/split_yuv.py	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/host_capture/split_yuv.py	2026-08-13 15:18:24.018360977 +0800
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Split a raw YUY2 stream into per-frame files.
+
+Usage:
+    python split_yuv.py <capture.raw> <width> <height> <out_dir> [expected_frames]
+"""
+import sys
+import os
+
+
+def main():
+    if len(sys.argv) < 5:
+        print(__doc__)
+        return 2
+
+    path = sys.argv[1]
+    w, h = int(sys.argv[2]), int(sys.argv[3])
+    out_dir = sys.argv[4]
+    want = int(sys.argv[5]) if len(sys.argv) > 5 else 0
+
+    fsz = w * h * 2
+
+    try:
+        with open(path, 'rb') as f:
+            data = f.read()
+    except OSError as e:
+        print(f"[ERROR] cannot read {path}: {e}")
+        return 1
+
+    n = len(data) // fsz
+    if n == 0:
+        print("[ERROR] file smaller than one frame.")
+        return 1
+
+    os.makedirs(out_dir, exist_ok=True)
+
+    for i in range(n):
+        frame = data[i * fsz:(i + 1) * fsz]
+        out_path = os.path.join(out_dir, f"host_frame_{i+1:05d}.yuv")
+        with open(out_path, 'wb') as f:
+            f.write(frame)
+
+    print(f"split {n} frames ({fsz} bytes each) -> {out_dir}/")
+    if want and n < want:
+        print(f"[WARN] only {n}/{want} frames captured.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
