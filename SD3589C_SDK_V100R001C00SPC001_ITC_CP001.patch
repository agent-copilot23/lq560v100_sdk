++static void uvc_still_prepare_queue_list(struct vb2_queue *q)
++{
++	int i;
++
++	for (i = 0; i < q->num_buffers; ++i) {
++		if (q->bufs[i]->state == VB2_BUF_STATE_DEQUEUED) {
++			q->bufs[i]->state = VB2_BUF_STATE_QUEUED;
++			list_add_tail(&q->bufs[i]->queued_entry, &q->queued_list);
++			q->queued_count++;
++		}
++	}
++}
