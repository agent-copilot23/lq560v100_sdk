+                      &init_attr->ae_route_sf, sizeof(ot_eis_vi_ae_route));
+    (ot_void)memcpy_s(&g_init_ae_route_sf_ex[master_pipe_id], sizeof(ot_eis_vi_ae_route_ex),
+                      &init_attr->ae_route_sf_ex, sizeof(ot_eis_vi_ae_route_ex));
+
+    return OT_SUCCESS;
+}
