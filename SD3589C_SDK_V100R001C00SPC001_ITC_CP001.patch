+            v = get_ot_stream()->mpi_eu_ops->profile_toolset_get(dev->dev_no);
+        }
+    }
+
+    dev->request_error_code.data[0] = 0x00;
+    dev->request_error_code.length = 1;
+
+    switch (req) {
+        case OT_UVC_SET_CUR:
+            resp->data[0] = 0x0;
+            resp->length = OT_UVC_RESP_LENGTH_5;
+            break;
+        case OT_UVC_GET_CUR:
+            (ot_void)memcpy_s(resp->data, sizeof(resp->data), &v, sizeof(uint64_t));
+            resp->length = OT_UVC_RESP_LENGTH_5;
+            break;
+        case OT_UVC_GET_DEF:
+            resp->data[0] = 0x4;
+            resp->length = OT_UVC_RESP_LENGTH_5;
+            break;
+        case OT_UVC_GET_INFO:
+            resp->data[0] = 0x3;
+            resp->length = OT_UVC_RESP_LENGTH_5;
