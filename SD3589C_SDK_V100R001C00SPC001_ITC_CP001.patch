+- [ ] **Step 5: å®ç°å†å² dump æ¸…ç† `uvc_dump_cleanup_old_runs()`**
+
+```c
+static int uvc_dump_run_id_compare(const void *a, const void *b)
+{
+    return strcmp(*(const char **)a, *(const char **)b);
+}
+
+static void uvc_dump_cleanup_old_runs(const char *dir, unsigned int keep)
+{
+    DIR *d;
+    struct dirent *ent;
+    char **run_ids = NULL;
+    unsigned int run_count = 0;
+    unsigned int run_cap = 0;
+    char path_buf[PATH_MAX];
+
+    if (keep == 0) {
+        return;
+    }
+
+    d = opendir(dir);
+    if (d == NULL) {
+        return;
+    }
+
+    while ((ent = readdir(d)) != NULL) {
+        const char *p = ent->d_name;
+        if (strncmp(p, UVC_DUMP_NAME_PREFIX "_", strlen(UVC_DUMP_NAME_PREFIX) + 1) != 0) {
+            continue;
+        }
+        /* format: uvc_dump_*_RUNID_* */
+        const char *run_start = strstr(p + strlen(UVC_DUMP_NAME_PREFIX) + 1, "_RUN_");
+        if (run_start == NULL) {
+            continue;
+        }
+        run_start += 5; /* skip "_RUN_" */
+        const char *run_end = strchr(run_start, '_');
+        if (run_end == NULL) {
+            continue;
+        }
+
+        size_t id_len = (size_t)(run_end - run_start);
+        if (run_count >= run_cap) {
+            run_cap = run_cap ? run_cap * 2 : 16;
+            run_ids = realloc(run_ids, run_cap * sizeof(char *));
+        }
+        run_ids[run_count] = malloc(id_len + 1);
+        (void)memcpy_s(run_ids[run_count], id_len + 1, run_start, id_len);
+        run_ids[run_count][id_len] = '\0';
+        run_count++;
+    }
+    closedir(d);
+
+    if (run_count <= keep) {
+        goto cleanup_ids;
+    }
+
+    qsort(run_ids, run_count, sizeof(char *), uvc_dump_run_id_compare);
+
+    /* åˆ é™¤æœ€è€çš„ run_count - keep ä¸ª run */
+    for (unsigned int i = 0; i < run_count - keep; i++) {
+        d = opendir(dir);
+        if (d == NULL) {
+            break;
+        }
+        while ((ent = readdir(d)) != NULL) {
+            (void)snprintf_s(path_buf, sizeof(path_buf), sizeof(path_buf) - 1,
+                             "%s/%s", dir, ent->d_name);
+            if (strstr(ent->d_name, run_ids[i]) != NULL) {
+                (void)unlink(path_buf);
+            }
+        }
+        closedir(d);
+    }
+
+cleanup_ids:
+    for (unsigned int i = 0; i < run_count; i++) {
+        free(run_ids[i]);
+    }
+    free(run_ids);
+}
+```
