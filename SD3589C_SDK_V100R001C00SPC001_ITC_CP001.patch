+int ot_stream_register_mpi_ops(struct stream_control_ops *sc_ops, struct processing_unit_ops *pu_ops,
+    struct camera_terminal_ops *ct_ops, struct encoding_unit_ops *eu_ops, struct extension_unit_ops *xu_ops)
