+static ot_s32 sample_uvc_save_raw_to_cache(int dev_no, ot_eis_video_frame *raw, unsigned int dump_id)
+{
+    frame_node_t *fnode = OT_NULL;
+    uvc_cache_t  *cache = uvc_cache_get(dev_no);
+    ot_u8 *src = OT_NULL;
+    ot_u32 w = raw->attr.width;
+    ot_u32 h = raw->attr.height;
+    ot_u32 dst_size = w * h * 2;            /* YUY2 ä¼ªè£…: 16-bit å®¹å™¨ */
+    ot_u32 src_stride = raw->buff.stride[0];
+    ot_u32 src_size = src_stride * h;       /* ç´§å‡‘ RAW10 æº */
+    ot_s32 ret;
+
+    if (cache == OT_NULL) { return OT_FAILURE; }
+    if (dump_id > 0) {
+        printf("###RAWDBG### dump raw cache enter: dev=%d sample=%u w=%u h=%u stride=%u\n",
+               dev_no, dump_id, w, h, src_stride);
+    }
+    get_node_from_queue(cache->free_queue, &fnode);
+    if (fnode == OT_NULL) {
+        if (dump_id > 0) {
+            printf("###RAWDBG### dump raw cache no free node: sample=%u\n", dump_id);
+        }
+        cache->dbg_free_drop++; /* RAWDBG: free_queue ç©º -> ä¸¢å¸§ */
+        return OT_FAILURE;
+    }
+
+    ret = ot_smr_mmap(raw->buff.phys_addr[0], src_size, OT_TRUE, (ot_void **)&src);
+    if (ret != OT_SUCCESS || src == OT_NULL) {
+        sample_print("raw mmap fail %#x\n", ret);
+        put_node_to_queue(cache->free_queue, fnode);
+        return OT_FAILURE;
+    }
+
+    if (dump_id > 0) {
+        uvc_dump_commit_frame(dump_id);
+    }
+
+    if (dump_id > 0) {
+        uvc_dump_frame_stage(dev_no, dump_id, "after_wch", "10bits", "RGGB",
+                             w, h, src_stride, src, src_size);
+    }
+
+    sample_uvc_raw10_mipi_to_u16_v2(src, src_stride, (ot_u16 *)fnode->mem, w, h);
+    fnode->used = dst_size;
+
+    if (dump_id > 0) {
+        uvc_dump_frame_stage(dev_no, dump_id, "after_unpack", "16bits", "RGGB",
+                             w, h, w * 2, fnode->mem, fnode->used);
+    }
+
+    /* é¦–å¸§æŠ½æ ·æ ¸å¯¹(éªŒè¯ååˆ é™¤è¯¥ printf) */
+    { static int once = 0; if (!once) { once = 1;
+      ot_u16 *pp = (ot_u16 *)fnode->mem;
+      printf("raw unpack first 8 u16: %u %u %u %u %u %u %u %u (w=%u h=%u stride=%u)\n",
+        pp[0], pp[1], pp[2], pp[3], pp[4], pp[5], pp[6], pp[7], w, h, src_stride); } }
+
+    ot_smr_munmap(src, src_size);
+    if (dump_id > 0) {
+        fnode->dump_id = dump_id;
+    }
+    put_node_to_queue(cache->ok_queue, fnode);
+    cache->dbg_unpack++; /* RAWDBG: unpack å…¥ ok_queue æˆåŠŸ */
+    return OT_SUCCESS;
+}
