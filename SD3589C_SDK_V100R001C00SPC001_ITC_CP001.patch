+static ot_void sample_uvc_get_default_venc_attr(uvc_media_ctx *ctx, sample_venc_attr *ve_cfg)
+{
+    encoder_property *ep = &gs_venc_prop[ctx->dev_no];
+    
+    switch(ep->format) {
+        case VIDEO_IMG_FORMAT_MJPEG:
+        {
+            ot_u32 bitrate = ep->height * ep->width * ep->fps / 2048;
+            bitrate = (bitrate < 6 * 10240) ? (6 * 10240) : bitrate;
+            ve_cfg->venc_attr.codecFormat =  OT_EIS_VENC_CODEC_MJPEG;
+            ve_cfg->venc_attr.common_attr.stream_buf_size = ALIGN_UP(ep->width, 16) * ALIGN_UP(ep->height, 16);
+            ve_cfg->venc_attr.mjpeg_attr.rc_attr.rc_mode  = OT_EIS_VENC_RC_MODE_CBR;
+            ve_cfg->venc_attr.mjpeg_attr.rc_attr.input_fps  = ep->fps;
+            ve_cfg->venc_attr.mjpeg_attr.rc_attr.output_fps = ep->fps;
+            ve_cfg->venc_attr.mjpeg_attr.rc_attr.cbr_attr.statis_time = 1;
+            ve_cfg->venc_attr.mjpeg_attr.rc_attr.cbr_attr.target_bit_rate = bitrate;
+        } break;
+
+        case VIDEO_IMG_FORMAT_H264:
+        {
+            ot_u32 bitrate = (ctx->sns_type == SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) ? (ep->height * ep->width / 2000) : (ep->height * ep->width / 1000);
+            ve_cfg->venc_attr.codecFormat =  OT_EIS_VENC_CODEC_H264;
+            ve_cfg->venc_attr.common_attr.stream_buf_size = ALIGN_UP(ep->width * ep->height * 3 / 2, 64);
+            ve_cfg->venc_attr.video_attr.rc_attr.rc_mode  = OT_EIS_VENC_RC_MODE_VBR;
+            ve_cfg->venc_attr.video_attr.rc_attr.vbr_attr.statis_time     = 3;
+            ve_cfg->venc_attr.video_attr.rc_attr.vbr_attr.target_bit_rate = bitrate;
+            ve_cfg->venc_attr.video_attr.rc_attr.input_fps  = ep->fps;
+            ve_cfg->venc_attr.video_attr.rc_attr.output_fps = ep->fps;
+            ve_cfg->venc_attr.video_attr.rc_attr.gop        = ep->fps;
+        } break;
+        default:
+            sample_print("unsupported codec format\n");
+            return;
+    }
+    ve_cfg->venc_attr.common_attr.max_pic_width  = ep->width;
+    ve_cfg->venc_attr.common_attr.max_pic_height = ep->height;
+    ve_cfg->venc_attr.common_attr.out_width      = ep->width;
+    ve_cfg->venc_attr.common_attr.out_height     = ep->height;
+}
