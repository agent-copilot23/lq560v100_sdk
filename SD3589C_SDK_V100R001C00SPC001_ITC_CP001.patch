diff -Naur --no-dereference base_lq560v100.custom/host_capture/analyze.py lq560v100.custom/host_capture/analyze.py
--- base_lq560v100.custom/host_capture/analyze.py	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/host_capture/analyze.py	2026-08-13 15:18:24.018360977 +0800
@@ -0,0 +1,274 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Analyze a raw YUY2 capture: per-frame md5/mean + inter-frame byte diff -> STATIC vs VARYING.
+
+Usage:
+    python analyze.py <capture.raw> <width> <height> [expected_frames]
+
+The verdict answers one question: is the host receiving VARYING frames
+(device delivers real data -> green screen is a viewer/rendering issue)
+or STATIC frames (device/UVC data problem, or host UVC driver stalled)?
+
+For the 6000p/3000p RAW path the bytes are RAW10-unpacked-to-u16 disguised as
+YUY2, so a working frame looks like grey noise (mean ~ 128, non-zero
+inter-frame diff). A green/static frame has near-zero inter-frame diff.
+"""
+import sys
+import hashlib
+import os
+import re
+
+
+def sampled_loop(buf, step):
+    """Yield buf[j] for j in range(0, len(buf), step)."""
+    for j in range(0, len(buf), step):
+        yield buf[j]
+
+
+def sampled_mean(buf, step):
+    s = 0
+    cnt = 0
+    for v in sampled_loop(buf, step):
+        s += v
+        cnt += 1
+    return s / cnt if cnt else 0.0
+
+
+def parse_board_filename(name):
+    """Parse uvc_dump_<dev>_RUN_<run>_F<frame_id>_<W>x<H>_<FMT>.yuv"""
+    m = re.match(r'uvc_dump_(\d+)_RUN_(.+?)_F(\d+)_(\d+)x(\d+)_([^.]+)\.yuv', name)
+    if not m:
+        return None
+    return {
+        'dev': int(m.group(1)),
+        'run': m.group(2),
+        'frame_id': int(m.group(3)),
+        'width': int(m.group(4)),
+        'height': int(m.group(5)),
+        'fmt': m.group(6),
+        'name': name,
+    }
+
+
+def load_board_frames(device_dir):
+    frames = {}
+    for name in sorted(os.listdir(device_dir)):
+        info = parse_board_filename(name)
+        if info is None:
+            continue
+        path = os.path.join(device_dir, name)
+        with open(path, 'rb') as f:
+            data = f.read()
+        info['md5'] = hashlib.md5(data).hexdigest()
+        info['data'] = data
+        info['size'] = len(data)
+        frames[info['frame_id']] = info
+    return frames
+
+
+def load_host_frames(host_dir):
+    frames = {}
+    pattern = re.compile(r'host_frame_(\d+)\.yuv')
+    for name in sorted(os.listdir(host_dir)):
+        m = pattern.match(name)
+        if not m:
+            continue
+        idx = int(m.group(1))
+        path = os.path.join(host_dir, name)
+        with open(path, 'rb') as f:
+            data = f.read()
+        frames[idx] = {
+            'idx': idx,
+            'md5': hashlib.md5(data).hexdigest(),
+            'data': data,
+            'size': len(data),
+            'name': name,
+        }
+    return frames
+
+
+def byte_diff(a, b, step=1):
+    if len(a) != len(b):
+        return -1, 0, 0.0
+    first = -1
+    diff_bytes = 0
+    total = 0
+    diff_sum = 0
+    for i in range(0, len(a), step):
+        total += 1
+        if a[i] != b[i]:
+            diff_bytes += 1
+            diff_sum += abs(a[i] - b[i])
+            if first < 0:
+                first = i
+    avg = diff_sum / total if total else 0.0
+    return first, diff_bytes, avg
+
+
+def compare_frames(board_frames, host_frames):
+    host_md5_map = {}
+    for idx, info in host_frames.items():
+        host_md5_map.setdefault(info['md5'], []).append(idx)
+
+    matched = {}
+    missing = []
+    mismatched = []
+
+    for frame_id in sorted(board_frames.keys()):
+        b = board_frames[frame_id]
+        host_idxs = host_md5_map.get(b['md5'])
+        if not host_idxs:
+            missing.append(frame_id)
+            continue
+        h = host_frames[host_idxs[0]]
+        matched[frame_id] = h['idx']
+        if b['data'] != h['data']:
+            step = max(1, len(b['data']) // 200000)
+            first, diff_bytes, avg = byte_diff(b['data'], h['data'], step)
+            mismatched.append({
+                'frame_id': frame_id,
+                'host_idx': h['idx'],
+                'first_diff': first,
+                'diff_bytes': diff_bytes,
+                'avg_abs_diff': avg,
+            })
+
+    extra = set(host_frames.keys()) - set(matched.values())
+    return matched, mismatched, missing, sorted(extra)
+
+
+def print_compare_report(board_frames, host_frames, matched, mismatched, missing, extra):
+    print("=" * 64)
+    print("UVC board vs host YUV comparison")
+    print(f"board frames : {len(board_frames)}")
+    print(f"host frames  : {len(host_frames)}")
+    print(f"matched      : {len(matched)}/{len(board_frames)} (by md5)")
+    print(f"identical    : {len(matched) - len(mismatched)}/{len(matched)}")
+    print("-" * 64)
+
+    if mismatched:
+        print(f"mismatched   : {len(mismatched)}")
+        for m in mismatched:
+            print(f"  frame id {m['frame_id']:05d} (host idx {m['host_idx']:05d}): "
+                  f"first diff at offset {m['first_diff']}, "
+                  f"diff_bytes={m['diff_bytes']}, avg_abs_diff={m['avg_abs_diff']:.2f}")
+
+    if missing:
+        print(f"missing on host: {len(missing)}")
+        print("  " + ", ".join(f"{f:05d}" for f in missing))
+
+    if extra:
+        print(f"extra on host  : {len(extra)}")
+        print("  " + ", ".join(f"{e:05d}" for e in extra))
+
+    print("-" * 64)
+    print("VERDICT:")
+    if not matched:
+        print("  >>> NO MATCH : no board frame found in host capture.")
+    elif mismatched:
+        print("  >>> MISMATCHED : byte corruption detected between board and host.")
+    elif missing or extra:
+        print("  >>> PARTIAL : all matched frames identical, but frame counts differ.")
+    else:
+        print("  >>> IDENTICAL : all board frames match host frames byte-for-byte.")
+    print("=" * 64)
+
+
+def do_compare(device_dir, host_dir, w, h):
+    board_frames = load_board_frames(device_dir)
+    host_frames = load_host_frames(host_dir)
+
+    if not board_frames:
+        print("[ERROR] no board frames found in " + device_dir)
+        return 1
+    if not host_frames:
+        print("[ERROR] no host frames found in " + host_dir)
+        return 1
+
+    fsz = w * h * 2
+    sample = next(iter(board_frames.values()))
+    if sample['size'] != fsz:
+        print(f"[WARN] board frame size {sample['size']} != expected {fsz}")
+
+    matched, mismatched, missing, extra = compare_frames(board_frames, host_frames)
+    print_compare_report(board_frames, host_frames, matched, mismatched, missing, extra)
+    return 0
+
+
+def main():
+    if len(sys.argv) >= 2 and sys.argv[1] == '--compare':
+        if len(sys.argv) < 6:
+            print("Usage: python analyze.py --compare <device_dir> <host_dir> <width> <height>")
+            return 2
+        return do_compare(sys.argv[2], sys.argv[3], int(sys.argv[4]), int(sys.argv[5]))
+
+    if len(sys.argv) < 4:
+        print(__doc__)
+        return 2
+    path = sys.argv[1]
+    w, h = int(sys.argv[2]), int(sys.argv[3])
+    want = int(sys.argv[4]) if len(sys.argv) > 4 else 0
+    fsz = w * h * 2  # YUY2 = 2 bytes/pixel
+
+    try:
+        with open(path, 'rb') as f:
+            data = f.read()
+    except OSError as e:
+        print(f"[ERROR] cannot read {path}: {e}")
+        return 1
+
+    n = len(data) // fsz
+    print(f"file           : {path} ({len(data)} bytes)")
+    print(f"frame          : {w}x{h} = {fsz} bytes (YUY2)")
+    print(f"frames captured: {n}" + (f"  (wanted {want})" if want else ""))
+    if n == 0:
+        print("[ERROR] file smaller than one frame -- capture failed or wrong resolution.")
+        return 1
+    if want and n < want:
+        print(f"[WARN] only {n}/{want} frames captured -- slow/stalled (USB2 or host).")
+    print("-" * 64)
+
+    frames = [data[i * fsz:(i + 1) * fsz] for i in range(n)]
+    step = max(1, fsz // 200000)  # ~200k sample points -> fast stats on big frames
+
+    md5s, means = [], []
+    for i, fr in enumerate(frames):
+        digest = hashlib.md5(fr).hexdigest()[:12]   # full-frame md5 (C-fast)
+        mean = sampled_mean(fr, step)               # sampled mean
+        md5s.append(digest)
+        means.append(mean)
+        print(f"  frame {i:2d}: md5={digest}  mean={mean:6.1f}/255")
+
+    print("-" * 64)
+    uniq = len(set(md5s))
+
+    diffs = []
+    for i in range(1, n):
+        a, b = frames[i - 1], frames[i]
+        tot = 0
+        cnt = 0
+        for j in range(0, fsz, step):
+            tot += abs(a[j] - b[j])
+            cnt += 1
+        diffs.append(tot / cnt if cnt else 0.0)
+    avg_diff = sum(diffs) / len(diffs) if diffs else 0.0
+
+    print(f"unique frames    : {uniq}/{n}")
+    print(f"avg mean(luma)   : {sum(means) / len(means):.1f}/255  (~0 black/empty, ~128 grey noise)")
+    print(f"inter-frame diff : {avg_diff:.2f}/255  (0 = identical, larger = more varying)")
+    print("-" * 64)
+    print("VERDICT:")
+    if uniq <= 1 and avg_diff < 1.0:
+        print("  >>> STATIC : all frames identical -> host is NOT receiving varying data.")
+        print("               -> device/UVC-data problem (or host UVC driver stalled).")
+    elif avg_diff < 2.0:
+        print("  >>> NEAR-STATIC : frames nearly identical -> host rendering one frozen frame.")
+        print("               -> device/UVC-data problem.")
+    else:
+        print(f"  >>> VARYING : frames differ (diff={avg_diff:.1f}) -> host IS getting real data.")
+        print("               -> device delivers real frames; green screen = viewer rendering issue.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -Naur --no-dereference base_lq560v100.custom/host_capture/capture_compare.bat lq560v100.custom/host_capture/capture_compare.bat
--- base_lq560v100.custom/host_capture/capture_compare.bat	1970-01-01 08:00:00.000000000 +0800
+++ lq560v100.custom/host_capture/capture_compare.bat	2026-08-13 15:18:24.018360977 +0800
@@ -0,0 +1,110 @@
+@echo off
+setlocal enabledelayedexpansion
+
+rem ====== config (edit this section) ======
+rem CAMERA : DirectShow video device name (see devices.txt). Must match exactly.
+rem BAYER  : Bayer pattern for output filename, e.g. RGGB / BGGR / GRBG / GBRG.
+set "CAMERA=UVC Camera 1"
+set "BAYER=RGGB"
+rem =========================================
+
+rem ====== positional args: W H FRAMES [-split] [-compare device_dir] ======
+rem W x H   : YUY2 frame size. 3000p=4000x3000, 6000p=8000x6000.
+rem FRAMES  : number of raw frames to grab. Large frames over USB2 are slow.
+rem -split       : also split RAW_*.raw into host_frames/host_frame_*.yuv
+rem -compare dir : compare host frames with board-side dump directory
+rem =========================================================================
+
+rem Extract switches from args; remaining positional args are W H FRAMES.
+set "SPLIT=0"
+set "COMPARE_DIR="
+set "POS_ARGS="
+set "EXPECT_COMPARE=0"
+
+for %%a in (%*) do (
+    if "!EXPECT_COMPARE!"=="1" (
+        set "COMPARE_DIR=%%~a"
+        set "EXPECT_COMPARE=0"
+    ) else (
+        if "%%a"=="-split" (
+            set "SPLIT=1"
+        ) else if "%%a"=="-compare" (
+            set "EXPECT_COMPARE=1"
+        ) else (
+            set "POS_ARGS=!POS_ARGS! %%a"
+        )
+    )
+)
+
+rem Parse up to 3 positional args
+set "i=0"
+for %%a in (!POS_ARGS!) do (
+    if !i!==0 set "WIDTH=%%a"
+    if !i!==1 set "HEIGHT=%%a"
+    if !i!==2 set "FRAMES=%%a"
+    set /a i+=1
+)
+
+if "%WIDTH%"==""  set "WIDTH=4000"
+if "%HEIGHT%"=="" set "HEIGHT=3000"
+if "%FRAMES%"=="" set "FRAMES=8"
+
+rem Generate timestamped output filename: RAW_<W>x<H>_16bits_<BAYER>_<YYYYMMDDhhmmss>.raw
+for /f %%t in ('python -c "import datetime; print(datetime.datetime.now().strftime('%%Y%%m%%d%%H%%M%%S'))"') do set "TIMESTAMP=%%t"
+set "OUTFILE=RAW_%WIDTH%x%HEIGHT%_16bits_%BAYER%_%TIMESTAMP%.raw"
+rem ==================================================================================
+
+echo.
+echo ============================================================
+echo   UVC RAW frame capture ^& compare
+echo   camera = %CAMERA%
+echo   size   = %WIDTH%x%HEIGHT% YUY2 (RAW-as-YUY2)
+echo   frames = %FRAMES%
+if "%SPLIT%"=="1"       echo   split  = yes
+if not "%COMPARE_DIR%"=="" echo   compare= %COMPARE_DIR%
+echo ============================================================
+echo.
+
+where ffmpeg >nul 2>nul
+if errorlevel 1 ( echo [ERROR] ffmpeg not on PATH - see README.md & goto :end )
+where python >nul 2>nul
+if errorlevel 1 ( echo [ERROR] python not on PATH - see README.md & goto :end )
+
+echo [1/4] list DirectShow devices -> devices.txt (fix CAMERA= if your name differs)
+ffmpeg -hide_banner -list_devices true -f dshow -i dummy 2> devices.txt
+echo       done.
+echo.
+
+echo [2/4] capture %FRAMES% raw YUY2 frames -> %OUTFILE%
+echo       (USB2 is slow for big frames: 6000p ^~2s/frame, 3000p ^~0.5s/frame)
+ffmpeg -hide_banner -loglevel error -f dshow -video_size %WIDTH%x%HEIGHT% -pixel_format yuyv422 -i "video=%CAMERA%" -vframes %FRAMES% -f rawvideo -pix_fmt yuyv422 %OUTFILE%
+if errorlevel 1 ( echo [ERROR] raw capture failed - check CAMERA name and resolution in devices.txt & goto :end )
+echo       %OUTFILE% written.
+echo.
+
+echo [3/4] capture 3 decoded PNGs -> frame_00X.png (visual eyeball)
+ffmpeg -hide_banner -loglevel error -f dshow -video_size %WIDTH%x%HEIGHT% -pixel_format yuyv422 -i "video=%CAMERA%" -vframes 3 frame_%%03d.png 2>nul
+echo       done.
+echo.
+
+echo [4/4] analyze raw frames
+python analyze.py %OUTFILE% %WIDTH% %HEIGHT% %FRAMES%
+
+if "%SPLIT%"=="1" (
+    echo.
+    echo [5] split %OUTFILE% -> host_frames/
+    if exist host_frames ( rmdir /s /q host_frames )
+    python split_yuv.py %OUTFILE% %WIDTH% %HEIGHT% host_frames %FRAMES%
+)
+
+if not "%COMPARE_DIR%"=="" (
+    echo.
+    echo [6] compare board dump %COMPARE_DIR% with host_frames/
+    python analyze.py --compare %COMPARE_DIR% host_frames %WIDTH% %HEIGHT%
+)
+
+echo.
+echo Done. Open frame_001.png .. frame_003.png to look at the actual image.
+:end
+echo.
+endlocal
