+ */
+#include "ot_scenecomm.h"
+#include "ot_scene.h"
+#include "uvc_scene_auto.h"
+#include <unistd.h>
+
+typedef struct {
+    ot_eis_handle vi_pipe_hdl;
+    ot_eis_handle vp_grp_hdl;
+    ot_scene_param scene_param;
+    ot_bool   normal_thread_run;
+    pthread_t normal_thread_tid;
+} SceneAtuoContex;
+
+SceneAtuoContex gs_scene_ctx;
+
+static void *sample_uvc_scene_normal_proc(void *p)
+{
+    ot_s32 ret = OT_SUCCESS;
+
+    SceneAtuoContex *ctx = (SceneAtuoContex *)p;
+
+    while(ctx->normal_thread_run == OT_TRUE) {
+        ret = ot_scene_dynamic_normal_set_param(ctx->vi_pipe_hdl, ctx->vp_grp_hdl);
+        usleep(100 * 1000);
+        if (ret != OT_SUCCESS) {
+            printf("ot_scene_dynamic_normal_set_param failed, vi_pipe_hdl:0x%p, vp_grp_hdl:0x%p, ret:0x%x", \
+                ctx->vi_pipe_hdl, ctx->vp_grp_hdl, ret);
+            continue;
+        }
+    }
+
+    return OT_NULL;
+}
+
+ot_s32 sample_uvc_scene_auto_start(const char *ini_path, ot_eis_handle vi_pipe_hdl, ot_eis_handle vp_grp_hdl)
+{
+    ot_s32 ret = OT_SUCCESS;
+    SceneAtuoContex *ctx = &gs_scene_ctx;
+
+    memset(ctx, 0, sizeof(SceneAtuoContex));
+
+    ctx->vi_pipe_hdl = vi_pipe_hdl;
+    ctx->vp_grp_hdl  = vp_grp_hdl;
+
+    ret = ot_scene_create_param(ini_path, &ctx->scene_param, NULL);
+    if (ret != OT_SUCCESS) {
+        sample_print("ot_scene_create_param failed\n");
+        return ret;
+    }
+
+    /* RAW (åŠ 48m5 MJPG) é€šè·¯æ—  VPROC: vp_grp_hdl==NULL æ—¶,å…³æ‰ scene é‡Œæ‰€æœ‰ä¾èµ–
+     * vproc ç»„çš„æ¨¡å—(static_3dnr / dynamic_vproc / dynamic_3dnr)ã€‚å¦åˆ™ scene åŠ¨æ€
+     * çº¿ç¨‹ä¼šåå¤è°ƒ ot_eis_vproc_grp_get_3dnr/get_crop æŸ¥ä¸åˆ° vproc ç»„,ç‹‚åˆ· 0x80010055ã€‚
+     * scene åº“æŒ‰ module_state æ ‡å¿—é—¨æ§(ot_scene_setparam.c:1244/1420),init å‰ç½® FALSE å³è·³è¿‡ã€‚
+     * åˆ¤æ® vp_grp_hdl==NULL ç²¾ç¡®è¦†ç›–æ—  vproc çš„é€šè·¯,ä¸å½±å“ 12m20/8m30 çš„ MJPG/YUYV(æœ‰ vproc)ã€‚ */
+    if (vp_grp_hdl == OT_NULL) {
+        int pipe_i;
+        for (pipe_i = 0; pipe_i < OT_SCENE_PIPETYPE_NUM; pipe_i++) {
+            ctx->scene_param.pipe_param[pipe_i].module_state.static_3dnr   = OT_FALSE;
+            ctx->scene_param.pipe_param[pipe_i].module_state.dynamic_vproc = OT_FALSE;
+            ctx->scene_param.pipe_param[pipe_i].module_state.dynamic_3dnr  = OT_FALSE;
+        }
+        printf("scene_auto: no vproc group, skip static_3dnr/dynamic_vproc/dynamic_3dnr modules\n");
+    }
+
+    ret = ot_scene_init(&ctx->scene_param);
+    if (ret != OT_SUCCESS) {
+        sample_print("ot_scene_init failed, ret:0x%x\n", ret);
+        return ret;
+    }
+
+    ret = ot_scene_static_vi_set_param(vi_pipe_hdl, vp_grp_hdl);
+    if (ret != OT_SUCCESS) {
+        sample_print("ot_scene_static_vi_set_param failed, ret:0x%x\n", ret);
+        goto deinit_scene;
+    }
+
+    ret = ot_scene_dynamic_normal_init(vi_pipe_hdl);
+    if (ret != OT_SUCCESS) {
+        sample_print("ot_scene_dynamic_normal_init failed, ret:0x%x\n", ret);
+        goto deinit_scene;        
+    }
+
+    ctx->normal_thread_run = OT_TRUE;
+    ret = pthread_create(&ctx->normal_thread_tid, NULL, sample_uvc_scene_normal_proc, (ot_void *)ctx);
+    if (ret != 0) {
+        sample_print("create normal thread failed, ret=%d\n", ret);
+        goto deinit_dynamic_normal;
+    }
+
+    return OT_SUCCESS;
+
+deinit_dynamic_normal:
+    ot_scene_dynamic_normal_deinit(vi_pipe_hdl);
+
+deinit_scene:
+    ot_scene_deinit();
+
+    return ret;
+}
+
+void sample_uvc_scene_auto_stop()
+{
+    SceneAtuoContex *ctx = &gs_scene_ctx;
+    if (ctx->normal_thread_run) {
+        ctx->normal_thread_run = OT_FALSE;
+        pthread_join(ctx->normal_thread_tid, NULL);
+    }
+
+    ot_scene_dynamic_normal_deinit(ctx->vi_pipe_hdl);
+    ot_scene_deinit();
+}
