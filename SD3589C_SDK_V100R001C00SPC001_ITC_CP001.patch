+static void *sample_uvc_get_raw_proc(void *p)
+{
+    ot_s32 ret;
+    ot_u32 raw_dbg_cnt = 0;
+    uvc_media_ctx *ctx = (uvc_media_ctx *)p;
+    ot_eis_handle pipe_hdl = ctx->vi_cfg.pipe_info[0].pipe_hdl;
+    ot_eis_video_frame raw_frame = { 0 };
+    struct ot_uvc_dev *uvc_dev = get_uvc_device(ctx->dev_no);
+    uvc_cache_t *raw_cache = uvc_cache_get(ctx->dev_no); /* RAWDBG: ç”Ÿäº§è€…è®¡æ•° */
+
+    prctl(PR_SET_NAME, "get_raw", 0, 0, 0);
+    printf("###RAWDBG### get_raw_proc started (dev=%u pipe=%p streaming=%d skip=%u)\n",
+           ctx->dev_no, (void *)pipe_hdl, uvc_dev ? uvc_dev->i_streaming : -1,
+           (unsigned)ctx->skip_count);
+    while (ctx->send_strm_run == OT_TRUE) {
+        ret = ot_eis_vi_pipe_get_frame(pipe_hdl, &raw_frame, 1, -1);
+        if (ret != OT_SUCCESS) {
+            usleep(100 * 1000);
+            sample_print("###RAWDBG### ot_eis_vi_pipe_get_frame fail %#x\n", ret);
+            continue;
+        }
+        if (raw_cache != NULL) {
+            raw_cache->dbg_get_raw++; /* RAWDBG: get_frame æˆåŠŸè®¡æ•° */
+        }
+        if (raw_dbg_cnt < 3) {
+            printf("###RAWDBG### get_raw ok[%u] phys=0x%llx stride=%u w=%u h=%u\n",
+                raw_dbg_cnt, (unsigned long long)raw_frame.buff.phys_addr[0],
+                (unsigned)raw_frame.buff.stride[0],
+                (unsigned)raw_frame.attr.width, (unsigned)raw_frame.attr.height);
+        }
+        raw_dbg_cnt++;
+        if (raw_dbg_cnt <= 12) {
+            // printf("###RAWDBG### raw_frame[%u]: streaming=%d skip=%u dump_enabled=%d\n",
+            //        raw_dbg_cnt, uvc_dev ? uvc_dev->i_streaming : -1,
+            //        (unsigned)ctx->skip_count, uvc_dump_is_enabled());
+        }
+        if (ctx->skip_count == 0 && uvc_dev->i_streaming) {
+            unsigned int dump_id = 0;
+            (void)uvc_dump_begin_frame(&dump_id);
+            if (raw_dbg_cnt <= 12) {
+                // printf("###RAWDBG### raw_frame[%u]: dump_id=%u\n", raw_dbg_cnt, dump_id);
+            }
+            sample_uvc_save_raw_to_cache(ctx->dev_no, &raw_frame, dump_id);
+        } else {
+            ctx->skip_count--;
+        }
+        ot_eis_vi_pipe_release_frame(pipe_hdl, &raw_frame, 1);
+    }
+    return OT_NULL;
+}
+
+static void *sample_uvc_get_strm_proc(void *p)
+{
+    ot_s32 ret = OT_SUCCESS;
+    uvc_media_ctx *ctx = (uvc_media_ctx *)p;
+    sample_venc_attr* ve_cfg = &ctx->ve_cfg;
+    ot_eis_venc_chn_status status = { 0 };
+    struct ot_uvc_dev *uvc_dev = get_uvc_device(ctx->dev_no);
+
+    prctl(PR_SET_NAME, "get_strm", 0, 0, 0);
+
+    while (ctx->send_strm_run == OT_TRUE) {
+        ret = ot_eis_venc_chn_query_status(ve_cfg->venc_hdl, &status);
+        if (ret != OT_SUCCESS) {
+            usleep(10 * 1000);
+            continue;
+        }
+
+        if (status.unTaken_streams == 0) {
+            usleep(10 * 1000);
+            continue;
+        }
+
+        ot_eis_venc_stream ot_stream = { 0 };
+        ret = ot_eis_venc_chn_acquire_stream(ve_cfg->venc_hdl, &ot_stream, 1000);
+        if (ret != OT_SUCCESS) {
+            sample_print("ot_eis_venc_chn_acquire_stream chn[%d] failed with %#x!\n", (ot_s32)((intptr_t)ve_cfg->venc_hdl), ret);
+            continue;
+        }
+        if (ctx->skip_count == 0) {
+            sample_uvc_save_strm_to_cache(ctx->dev_no, &ot_stream);
+        }
+        else {
+            ctx->skip_count--;
+        }
+        
+        ret = ot_eis_venc_chn_release_stream(ve_cfg->venc_hdl, &ot_stream);
+        if (ret != OT_SUCCESS) {
+            sample_print("ot_eis_venc_chn_release_stream chn[%d] failed with %#x!\n", (ot_s32)((intptr_t)ve_cfg->venc_hdl), ret);
+        }
+    }
+    
+    return OT_NULL;
+}
+
+ot_void sample_uvc_get_default_media_cfg(uvc_media_ctx *ctx, int max_cnt)
+{
+    memset(ctx, 0, sizeof(uvc_media_ctx) * max_cnt);
+    for (int i = 0; i < max_cnt; i++) {
+        ctx[i].dev_no = i;
+        ctx[i].sns_type      = SONY_IMX582_MIPI_8M_30FPS_10BIT_DIRECT;
+        ctx[i].sns_switch    = OT_FALSE;
+        ctx[i].is_stream_run = OT_FALSE;
+        ctx[i].is_media_init = OT_FALSE;
+    }
+}
+
+ot_void sample_uvc_get_default_uvc_props(uvc_properties_t *uvc_props, int max_cnt)
+{
+    memset(uvc_props, 0, sizeof(uvc_properties_t) * max_cnt);
+    for (int i = 0; i < max_cnt; i++) {
+        uvc_props[i].brightness = 50;
+        uvc_props[i].contrast   = 99;
+        uvc_props[i].saturation = 50;
+        uvc_props[i].hue        = 50;
+        uvc_props[i].sharpness  = 50;
+        uvc_props[i].gamma      = 50;
+        uvc_props[i].white_balance_temperature = 6500;
+        uvc_props[i].backlight_compensation    = 0;
+        uvc_props[i].exposure_auto_mode        = 0x08;
+        uvc_props[i].exposure_absolute_time    = 200;
+        uvc_props[i].gain       = 1;
+    }
+}
+
+static ot_void sample_uvc_enable_vp_low_delay(ot_eis_handle vproc_chn_hdl)
+{
+    ot_s32 ret;
+    ot_eis_low_delay_info low_delay_info;
+
+    low_delay_info.enable = OT_TRUE;
+    low_delay_info.line_cnt = 32;
+    low_delay_info.one_buf_en = OT_FALSE;
+
+    ret = ot_eis_vproc_chn_set_low_delay(vproc_chn_hdl, &low_delay_info);
+    if (ret != OT_SUCCESS) {
+        sample_print("enable vproc chn low delay failed!\n");
+    }
+}
+
+ot_s32 sample_uvc_sc_init(ot_void)
+{
+    memset(gs_venc_prop, 0, sizeof(gs_venc_prop));
+    sample_uvc_get_default_media_cfg(gs_media_ctx, OT_UVC_MAX_CHN_NUM);
+
+    return OT_SUCCESS;
+}
+
+ot_s32 sample_uvc_sc_deinit(ot_void)
+{
+    for (ot_u32 i = 0; i < OT_UVC_MAX_CHN_NUM; i++) {
+        sample_uvc_media_stream_deinit(gs_media_ctx + i);
+    }
+    return OT_SUCCESS;
+}
+
+ot_s32 sample_uvc_sc_startup(ot_u32 dev_no)
+{
+    ot_s32 ret = OT_SUCCESS;
+
+    uvc_media_ctx    *ctx = gs_media_ctx + dev_no;
+    encoder_property *ep  = gs_venc_prop + dev_no;
+    char *scene_ini_path  = NULL;
+    ot_eis_vi_public_attr pub_attr;
+    uvc_properties_t      uvc_props;
+    
+    if (ctx->is_stream_run) {
+        sample_uvc_sc_shutdown(dev_no);
+    }
+    
+    sample_print("video streaming info, format:0x%x, resolution:%dx%d, fps:%d\n", ep->format, ep->width, ep->height, ep->fps);
+    if (ep->width == 8000 && ep->height == 6000) {
+        ctx->sns_type  = SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT;
+        scene_ini_path = "param/imx582-48m5";
+    }
+    else if (ep->width == 4000 && ep->height == 3000) {
+        ctx->sns_type = SONY_IMX582_MIPI_12M_20FPS_10BIT_DIRECT;
+        scene_ini_path = "param/imx582-12m20";
+    }
+    else {
+        ctx->sns_type = SONY_IMX582_MIPI_8M_30FPS_10BIT_DIRECT;
+        scene_ini_path = "param/imx582-8m30";
+    }
+
+    ret = sample_uvc_media_stream_init(ctx);
+
+    if (ret != OT_SUCCESS) {
+        sample_print("uvc media init failed, ret=%d", ret);
+        return ret;
+    }
+
+    ctx->skip_count = ep->fps; // skip frames for 1 second to wait auto exposure stable
+
+    ctx->vp_cfg.grp_hdl = OT_NULL;
+
+    if (sample_uvc_is_raw_fmt(ep)) {
+        ot_eis_vi_rc_attr rc_attr;
+        ot_s32 rc_ret = 0, dump_ret = 0;
+        memset(&rc_attr, 0, sizeof(rc_attr));
+        rc_attr.enable = OT_FALSE;                                      /* å…³ Radial Crop(RAW è¾“å‡ºå¿…é¡») */
+        rc_ret = ot_eis_vi_rc_set_attr(ctx->vi_cfg.pipe_info[0].pipe_hdl, &rc_attr);
+        dump_ret = ot_eis_vi_pipe_enable_dump(ctx->vi_cfg.pipe_info[0].pipe_hdl, OT_TRUE, 2); /* WCH dump, depth=2 */
+        printf("###RAWDBG### rc_set_attr ret:0x%x  enable_dump ret:0x%x\n", (unsigned)rc_ret, (unsigned)dump_ret);
+    }
+    else if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) {
+        ot_bool pipe_sw[OT_EIS_VPROC_GRP_PIPE_MAX_NUM] = {OT_TRUE, OT_FALSE, OT_FALSE, OT_FALSE};
+        ot_bool chn_sw[OT_EIS_VPROC_GRP_CHN_MAX_NUM]   = {OT_TRUE, OT_FALSE, OT_FALSE, OT_FALSE};
+
+        sample_media_vproc_get_default_attr_by_snsor(ctx->sns_type, &ctx->vp_cfg);
+        /* update vproc chn resolution */
+        if (ep->format == VIDEO_IMG_FORMAT_YUYV) {
+            ctx->vp_cfg.chn_attr[0].image_attr.pixel_fmt = OT_EIS_IMAGE_FORMAT_YUV_422_SEMIPLANAR;
+        } else {
+            ctx->vp_cfg.chn_attr[0].image_attr.pixel_fmt = OT_EIS_IMAGE_FORMAT_YUV_420_SEMIPLANAR;
+        }        
+
+        ctx->vp_cfg.chn_attr[0].image_attr.width  = ep->width;
+        ctx->vp_cfg.chn_attr[0].image_attr.height = ep->height;
+
+        if (sample_uvc_is_yuv_fmt(ep)) {
+            ctx->vp_cfg.chn_attr[0].mode = OT_EIS_VPROC_WORK_MODE_USER;
+            ctx->vp_cfg.chn_attr[0].frame_queue_depth = 3;
+            ret = sample_uvc_user_mode_buf_pool_creat(&ctx->vp_cfg.chn_attr[0].image_attr, 5, &ctx->user_pool_hdl);
+            if (ret != OT_SUCCESS) {
+                sample_print("sample_uvc_user_mode_buf_pool_creat failed, ret:0x%x\n", ret);
+                goto media_deinit;
+            }
+
+            ctx->vp_cfg.chn_attr[0].pool_handle = ctx->user_pool_hdl;
+        }
+
+        /* start vproc */
+        ret = sample_comm_start_vproc(&ctx->vp_cfg, pipe_sw, chn_sw);
+        if (ret != OT_SUCCESS) {
+            sample_print("sample_comm_start_vproc failed, ret:0x%x\n", ret);
+            goto start_vp_failed;
+        }
+
+        /* bind vi chn vp grp */
+        ret = sample_comm_vi_bind_vproc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->vp_cfg.pipe_hdl[0], ctx->media_pipe_hdl);
+        if (ret != OT_SUCCESS) {
+            sample_print("sample_comm_vi_bind_vproc failed, ret:0x%x\n", ret);
+            goto vi_bind_vp_failed;
+        }
+    }
+    
+    ret = sample_uvc_scene_auto_start(scene_ini_path, ctx->vi_cfg.pipe_info[0].pipe_hdl, ctx->vp_cfg.grp_hdl);
+    if (ret != OT_SUCCESS) {
+        sample_print("sample_uvc_scene_auto_start failed, ret:0x%x\n", ret);
+        goto scene_auto_start_failed;
+    }
+    
+    ot_eis_vi_public_get_attr(ctx->vi_cfg.pipe_info[0].pipe_hdl, &pub_attr);
+    pub_attr.frame_rate = ep->fps;
+    printf("set frame_rate %d\n", ep->fps);
+    ot_eis_vi_public_set_attr(ctx->vi_cfg.pipe_info[0].pipe_hdl, &pub_attr);
+
+    if (!sample_uvc_is_yuv_fmt(ep)) {
+        sample_uvc_enable_vp_low_delay(ctx->vp_cfg.chn_hdl[0]);
+        /* update venc attr */
+        sample_uvc_get_default_venc_attr(ctx, &ctx->ve_cfg);
+        /* start venc*/
+        ret = sample_comm_venc_start(&ctx->ve_cfg);
+        if (ret != OT_SUCCESS) {
+            sample_print("sample_comm_venc_start failed, ret:0x%x\n", ret);
+            goto start_venc_failed;
+        }
+
+        if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) {
+            ret = sample_comm_vproc_bind_venc(ctx->vp_cfg.chn_hdl[0], ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+        }
+        else {
+            ret = sample_comm_vi_bind_venc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+        }
+
+        if (ret != OT_SUCCESS) {
+            sample_print("sample_comm_venc_start failed, ret:0x%x\n", ret);
+            goto bind_venc_failed;
+        }
+    }
+
+    if (sample_uvc_is_raw_fmt(ep)) {
+        ctx->send_strm_run = OT_TRUE;
+        ret = pthread_create(&ctx->send_strm_tid, OT_NULL, sample_uvc_get_raw_proc, (ot_void*)ctx);
+    }
+    else if (sample_uvc_is_yuv_fmt(ep)) {
+        if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) {
+            ctx->send_strm_run = OT_TRUE;
+            ret = pthread_create(&ctx->send_strm_tid, OT_NULL, sample_uvc_get_yuv_proc, (ot_void*)ctx);
+        }
+    }
+    else {
+        ctx->send_strm_run = OT_TRUE;
+        ret = pthread_create(&ctx->send_strm_tid, OT_NULL, sample_uvc_get_strm_proc, (ot_void*)ctx);
+    }
+
+    if (ret != OT_SUCCESS) {
+        sample_print("start get stream thread failed\n");
+        goto start_stream_thread_failed;
+    }
+
+    ret = uvc_properties_load(UVC_PROP_FILE_PATH, &uvc_props);
+    if (ret == 0) {
+        uvc_properties_apply(dev_no, &uvc_props);
+        gs_uvc_props[dev_no] = uvc_props;
+    }
+
+    ctx->is_stream_run = OT_TRUE;
+
+    return OT_SUCCESS;
+
+start_stream_thread_failed:
+    if (!sample_uvc_is_yuv_fmt(ep)) {
+        if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) {
+            sample_comm_vproc_un_bind_venc(ctx->vp_cfg.chn_hdl[0], ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+        }
+        else {
+            sample_comm_vi_un_bind_venc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+        }
+    }
+
+bind_venc_failed:
+    if (!sample_uvc_is_yuv_fmt(ep)) {
+        sample_comm_venc_stop(&ctx->ve_cfg);
+    }
+
+start_venc_failed:
+    sample_uvc_scene_auto_stop();
+
+scene_auto_start_failed:
+    if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT && !sample_uvc_is_raw_fmt(ep)) {
+        sample_comm_vi_un_bind_vproc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->vp_cfg.pipe_hdl[0], ctx->media_pipe_hdl);
+    }
+
+vi_bind_vp_failed:
+    if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT && !sample_uvc_is_raw_fmt(ep)) {
+        sample_comm_stop_vproc(&ctx->vp_cfg);
+    }
+
+start_vp_failed:
+    if (ctx->sns_type != SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT && sample_uvc_is_yuv_fmt(ep) && !sample_uvc_is_raw_fmt(ep)) {
+        ot_buffer_pool_destroy(ctx->user_pool_hdl);
+        ot_buffer_pool_deinit();
+    }
+media_deinit:
+    sample_uvc_media_stream_deinit(ctx);
+
+    return ret;
+}
+
+ot_s32 sample_uvc_sc_shutdown(ot_u32 dev_no)
+{
+    uvc_media_ctx    *ctx = gs_media_ctx + dev_no;
+    encoder_property *ep  = gs_venc_prop + dev_no;
+    uvc_properties_t uvc_prop;
+    if (ctx->is_stream_run == OT_FALSE) {
+        return OT_SUCCESS;
+    }
+
+    uvc_properties_get_current(dev_no, &uvc_prop);
+    if (memcmp(&uvc_prop, &gs_uvc_props[dev_no], sizeof(uvc_properties_t)) != 0) {
+        uvc_properties_save(UVC_PROP_FILE_PATH, &uvc_prop);
+    }
+
+    ctx->send_strm_run = OT_FALSE;
+    pthread_join(ctx->send_strm_tid, OT_NULL);
+    
+    sample_uvc_scene_auto_stop();
+
+    if (sample_uvc_is_raw_fmt(ep)) {
+        ot_eis_vi_pipe_enable_dump(ctx->vi_cfg.pipe_info[0].pipe_hdl, OT_FALSE, 0);
+    }
+    else if (ctx->sns_type == SONY_IMX582_MIPI_48M_5FPS_10BIT_DIRECT) {
+        sample_comm_vi_un_bind_venc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+        sample_comm_venc_stop(&ctx->ve_cfg);
+    }
+    else {
+        if (sample_uvc_is_yuv_fmt(ep)) {
+            sample_comm_vi_un_bind_vproc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->vp_cfg.pipe_hdl[0], ctx->media_pipe_hdl);
+            sample_comm_stop_vproc(&ctx->vp_cfg);
+            ot_buffer_pool_destroy(ctx->user_pool_hdl);
+            ot_buffer_pool_deinit();
+        }
+        else {
+            sample_comm_vproc_un_bind_venc(ctx->vp_cfg.chn_hdl[0], ctx->ve_cfg.venc_hdl, ctx->media_pipe_hdl);
+            sample_comm_venc_stop(&ctx->ve_cfg);
+            sample_comm_vi_un_bind_vproc(ctx->vi_cfg.pipe_info[0].chn_info.chn_hdl, ctx->vp_cfg.pipe_hdl[0], ctx->media_pipe_hdl);
+            sample_comm_stop_vproc(&ctx->vp_cfg);
+        }
+    }
+    sample_uvc_media_stream_deinit(ctx);
+
+    ctx->is_stream_run = OT_FALSE;
+
+    return OT_SUCCESS;
+}
+
+ot_s32 sample_uvc_sc_set_property(ot_u32 dev_no, encoder_property *ep)
+{
+    if (ep == NULL) {
+        err("p is NULL\n");
+        return OT_FAILURE;
+    }
+   
+    (ot_void)memcpy_s(&gs_venc_prop[dev_no], sizeof(encoder_property), ep, sizeof(encoder_property));
+    return 0;
+}
+
+ot_void sample_uvc_sc_get_property(ot_u32 dev_no, encoder_property *ep)
+{
+    if (ep == NULL) {
+        err("ep is NULL\n");
+        return;
+    }
+    (ot_void)memcpy_s(ep, sizeof(encoder_property), &gs_venc_prop[dev_no], sizeof(encoder_property));
+}
+
+ot_s32 sample_uvc_sc_set_idr(ot_u32 dev_no)
+{
+    return OT_SUCCESS;
+}
+
+ot_s32 sample_uvc_sc_get_send(ot_u32 dev_no)
+{
+    ot_s32 ret = OT_SUCCESS;
+    uvc_media_ctx *ctx = &gs_media_ctx[dev_no];
+    if (!ctx->is_stream_run) {
+        return OT_FAILURE;
+    }
+
+    if (sample_uvc_is_yuv_fmt(&gs_venc_prop[dev_no])) {
+        ot_eis_handle vp_chn_hdl = ctx->vp_cfg.chn_hdl[0];
+        ot_eis_img_frame frame = { 0 };
+        ret = ot_eis_vproc_chn_acquire_frame(vp_chn_hdl, &frame, -1);
+        if (ret == OT_SUCCESS) {   
+            ret = sample_uvc_save_yuv_to_cache(ctx->dev_no, &frame);
+            ot_eis_vproc_chn_release_frame(vp_chn_hdl, &frame);
+        }
+    }
+    else {
+        sample_venc_attr* ve_cfg = &ctx->ve_cfg;
+        ot_eis_venc_chn_status status = { 0 };
+        ot_eis_venc_stream ot_stream = { 0 };
+        ret = ot_eis_venc_chn_query_status(ve_cfg->venc_hdl, &status);
+        if (ret == OT_SUCCESS) {
+            if (status.unTaken_streams == 0) {
+                return OT_FAILURE;
+            }
+            ret = ot_eis_venc_chn_acquire_stream(ve_cfg->venc_hdl, &ot_stream, -1);
+        }
+        if (ret == OT_SUCCESS) {
+            ret = sample_uvc_save_strm_to_cache(ctx->dev_no, &ot_stream);
+            ot_eis_venc_chn_release_stream(ve_cfg->venc_hdl, &ot_stream);
+        }
+    }
+    
+    return ret;
+}
